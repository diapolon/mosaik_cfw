{
  // Tessera: home a carosello con riquadri arrotondati, ispirata alle console moderne.
  // Tutte le misure sono frazioni dell'altezza dello schermo: il tema si adatta
  // da solo a 1280x720 (Smart Pro) e 1024x768 (Brick Pro).
  "name": "Tessera",
  "author": "Prototipo",
  "title": "Mosaik",
  "layout": "carousel",
  "sound_style": "soft",
  "fonts": {
    "regular": "../_shared/fonts/Nunito.ttf:3",
    "title": "../_shared/fonts/Nunito.ttf:6"
  },
  "media": {
    // immagini scaricate dallo scraper, in ordine di preferenza
    "cover": ["title", "snap"],
    "cover_style": "fill"
  },
  "metrics": {
    "topbar_h": 0.105,
    "hintbar_h": 0.10,
    "margin": 0.06,
    "tile_size": 0.32,
    "tile_aspect": 1.333,
    "grid_tile": 0.21,
    "tile_gap": 0.022,
    "tile_radius": 0.012,
    "select_border": 0.007,
    "icon_size": 0.095,
    "font_small": 0.027,
    "font_normal": 0.035,
    "font_title": 0.045,
    "font_big": 0.075,
    "list_row_h": 0.075,
    "panel_radius": 0.014
  },
  "animation": { "speed": 16, "pulse": true },
  "variants": {
    "light": {
      "background": "#EBEBEB",
      "surface": "#FFFFFF",
      "text": "#2B2B2B",
      "text_dim": "#7D7D7D",
      "accent": "#0FB1D4",
      "accent_text": "#FFFFFF",
      "tile": "#FFFFFF",
      "shadow": "#0000002A",
      "line": "#2B2B2B30"
    },
    "dark": {
      "background": "#2D2D30",
      "surface": "#3B3B40",
      "text": "#F2F2F2",
      "text_dim": "#A6A6AD",
      "accent": "#27D1EC",
      "accent_text": "#10181C",
      "tile": "#3B3B40",
      "shadow": "#00000060",
      "line": "#FFFFFF30"
    },
    "corallo": {
      "background": "#F3ECE8",
      "surface": "#FFFFFF",
      "text": "#2E2522",
      "text_dim": "#8A7A74",
      "accent": "#F0645A",
      "accent_text": "#FFFFFF",
      "tile": "#FFFFFF",
      "shadow": "#0000002A",
      "line": "#2E252230"
    },
    "salvia": {
      "background": "#E6EEE9",
      "surface": "#FFFFFF",
      "text": "#22302A",
      "text_dim": "#73857C",
      "accent": "#2FA36B",
      "accent_text": "#FFFFFF",
      "tile": "#FFFFFF",
      "shadow": "#0000002A",
      "line": "#22302A30"
    },
    "notte": {
      "background": "#161C2C",
      "surface": "#222B40",
      "text": "#EEF2FA",
      "text_dim": "#98A3BD",
      "accent": "#FFB84D",
      "accent_text": "#1A1408",
      "tile": "#222B40",
      "shadow": "#00000070",
      "line": "#FFFFFF26"
    }
  }
}
