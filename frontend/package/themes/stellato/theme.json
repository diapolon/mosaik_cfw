{
  // Stellato: come il menu di una console sotto un cielo di stelle. In alto il titolo e le schede
  // Preferiti, Recenti, Piattaforme (L/R); a sinistra il nome grande della scelta; al centro un
  // carosello di schede con il disegno della piattaforma, produttore e anno; in basso una fascia
  // di colore. Tema dello Store: richiede il layout "galleria" (sistema 0.9.32 o dopo); con un
  // sistema più vecchio si vede con i riquadri di Tessera.
  "name": "Stellato",
  "author": "Mosaik",
  "version": "1.0",
  "title": "Mosaik",
  "title_uppercase": true,
  "layout": "galleria",
  "sound_style": "soft",
  "texts": {
    "it": { "title": "Stellato", "description": "Cielo stellato, schede in alto e un carosello di piattaforme con produttore e anno" },
    "en": { "title": "Starry", "description": "Starry sky, tabs on top and a carousel of platforms with maker and year" },
    "es": { "title": "Estrellado", "description": "Cielo estrellado, pestañas arriba y un carrusel de plataformas con fabricante y año" },
    "fr": { "title": "Étoilé", "description": "Ciel étoilé, onglets en haut et un carrousel de plateformes avec fabricant et année" },
    "de": { "title": "Sternenhimmel", "description": "Sternenhimmel, Reiter oben und ein Karussell der Plattformen mit Hersteller und Jahr" },
    "pt": { "title": "Estrelado", "description": "Céu estrelado, separadores em cima e um carrossel de plataformas com fabricante e ano" }
  },
  "fonts": {
    "regular": "../_shared/fonts/Nunito.ttf:3",
    "title": "../_shared/fonts/Nunito.ttf:8"
  },
  "media": {
    "cover": ["title", "snap"],
    "cover_style": "fill"
  },
  "metrics": {
    "topbar_h": 0.11,
    "hintbar_h": 0.10,
    "margin": 0.05,
    "tile_size": 0.32,
    "tile_aspect": 1.333,
    "grid_tile": 0.21,
    "tile_gap": 0.022,
    "tile_radius": 0.012,
    "select_border": 0.007,
    "icon_size": 0.095,
    "font_small": 0.027,
    "font_normal": 0.036,
    "font_title": 0.046,
    "font_big": 0.085,
    "list_row_h": 0.075,
    "panel_radius": 0.014
  },
  "animation": { "speed": 16, "pulse": true },
  "effects": { "stars": true },
  "variants": {
    "notte": {
      "label": { "it": "Notte", "en": "Night", "es": "Noche", "fr": "Nuit", "de": "Nacht", "pt": "Noite" },
