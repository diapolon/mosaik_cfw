{
  // Copertina: la home come la copertina di un fumetto. In alto l'illustrazione grande della
  // piattaforma scelta su una fascia obliqua, con il nome a lettere piene; in basso la striscia
  // delle piattaforme e il contatore. Tema dello Store: richiede il layout "vetrina" (sistema
  // 0.9.30 o dopo); con un sistema più vecchio si vede con i riquadri di Tessera.
  "name": "Copertina",
  "author": "Mosaik",
  "version": "1.0",
  "title": "Mosaik",
  "layout": "vetrina",
  "sound_style": "soft",
  "texts": {
    "it": { "title": "Copertina", "description": "Illustrazione grande della piattaforma e striscia in basso, come una copertina a fumetti" },
    "en": { "title": "Cover", "description": "Big platform artwork and a strip below, like a comic book cover" },
    "es": { "title": "Portada", "description": "Ilustración grande de la plataforma y una franja abajo, como una portada de cómic" },
    "fr": { "title": "Couverture", "description": "Grande illustration de la plateforme et un bandeau en bas, comme une couverture de BD" },
    "de": { "title": "Titelbild", "description": "Großes Plattformbild und eine Leiste unten, wie ein Comic-Cover" },
    "pt": { "title": "Capa", "description": "Ilustração grande da plataforma e uma faixa em baixo, como uma capa de banda desenhada" }
  },
  "fonts": {
    "regular": "../_shared/fonts/Nunito.ttf:3",
    "title": "../_shared/fonts/Nunito.ttf:8"
  },
  "media": {
