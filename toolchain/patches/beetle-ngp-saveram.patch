diff --git a/mednafen/ngp/flash.c b/mednafen/ngp/flash.c
index e7b398f..9fd7c76 100644
--- a/mednafen/ngp/flash.c
+++ b/mednafen/ngp/flash.c
@@ -58,6 +58,45 @@ typedef struct
 static FlashFileBlockHeader	blocks[256];
 static uint16_t block_count;
 
+/* Mosaik: see flash.h */
+static uint8_t flash_sram[FLASH_SRAM_SIZE];
+static bool flash_sram_dirty;      /* the game wrote flash since the last rebuild */
+static bool flash_sram_pending;    /* game loaded, frontend buffer not applied yet */
+static bool flash_sram_overflow;   /* too big for the buffer: use the .flash file */
+
+/* flash lives at 0x200000-0x3FFFFF (chip 0) and 0x800000-0x9FFFFF (chip 1) */
+static int flash_range_ok(uint32_t start, uint32_t len)
+{
+   uint32_t end = start + len;
+   return (start >= 0x200000 && end <= 0x400000) || (start >= 0x800000 && end <= 0xA00000);
+}
+
+int flash_data_ok(const uint8_t *data, uint32_t len)
+{
+   FlashFileHeader header;
+   uint32_t pos = sizeof(FlashFileHeader);
+   uint16_t i;
+
+   if (!data || len < sizeof(FlashFileHeader))
+      return 0;
+   memcpy(&header, data, sizeof(header));
+   if (header.valid_flash_id != FLASH_VALID_ID || header.block_count > FLASH_MAX_BLOCKS
+         || header.total_file_length > len || header.total_file_length < sizeof(FlashFileHeader))
+      return 0;
+   for (i = 0; i < header.block_count; i++)
+   {
+      FlashFileBlockHeader b;
+      if (pos + sizeof(b) > header.total_file_length)
+         return 0;
+      memcpy(&b, data + pos, sizeof(b));
+      pos += sizeof(b);
+      if (pos + b.data_length > header.total_file_length || !flash_range_ok(b.start_address, b.data_length))
+         return 0;
+      pos += b.data_length;
+   }
+   return pos == header.total_file_length;
+}
+
 void flash_optimise_blocks(void)
 {
    int i, j;
@@ -149,7 +188,7 @@ void do_flash_read(uint8_t *flashdata)
    flash_optimise_blocks();		//Optimise
 }
 
-void flash_read(void)
+static void flash_read_file(void)
 {
    FlashFileHeader header;
    uint8_t* flashdata;
@@ -170,20 +209,32 @@ void flash_read(void)
       return;
 
    //Read the flash data
+   if (header.total_file_length > 0x1000000)
+      return;
    flashdata = (uint8_t*)malloc(header.total_file_length * sizeof(uint8_t));
-   system_io_flash_read(flashdata, header.total_file_length);
-
-   do_flash_read(flashdata);
+   if (!flashdata)
+      return;
+   if (system_io_flash_read(flashdata, header.total_file_length)
+         && flash_data_ok(flashdata, header.total_file_length))
+      do_flash_read(flashdata);
 
    free(flashdata);
 }
 
+void flash_read(void)
+{
+   flash_read_file();
+   flash_sram_refresh();
+   flash_sram_pending = true;
+}
+
 void flash_write(uint32_t start_address, uint16_t length)
 {
    uint16_t i;
 
    //Now we need a new flash command before the next flash write will work!
    memory_flash_command = false;
+   flash_sram_dirty = true;
 
    for (i = 0; i < block_count; i++)
    {
@@ -202,6 +253,10 @@ void flash_write(uint32_t start_address, uint16_t length)
    }
 
    // New block needs to be added
+   if (block_count >= FLASH_MAX_BLOCKS)
+      flash_optimise_blocks();
+   if (block_count >= FLASH_MAX_BLOCKS)
+      return;
    blocks[block_count].start_address = start_address;
    blocks[block_count].data_length = length;
    block_count++;
@@ -261,7 +316,13 @@ uint8_t *make_flash_commit(int32_t *length)
 void flash_commit(void)
 {
    int32_t length = 0;
-   uint8_t *flashdata = make_flash_commit(&length);
+   uint8_t *flashdata;
+
+   /* Mosaik: the frontend saves the buffer; the .flash file is only read (saves of
+      earlier versions) unless the save is too big for the buffer */
+   if (!flash_sram_overflow)
+      return;
+   flashdata = make_flash_commit(&length);
 
    if (!flashdata)
       return;
@@ -269,3 +330,41 @@ void flash_commit(void)
    system_io_flash_write(flashdata, length);
    free(flashdata);
 }
+
+/* Mosaik: flash save as RETRO_MEMORY_SAVE_RAM */
+uint8_t *flash_sram_data(void)
+{
+   return flash_sram;
+}
+
+void flash_sram_refresh(void)
+{
+   int32_t length = 0;
+   uint8_t *flashdata = make_flash_commit(&length);
+
+   memset(flash_sram, 0, sizeof(flash_sram));
+   flash_sram_overflow = false;
+   if (flashdata && length <= FLASH_SRAM_SIZE)
+      memcpy(flash_sram, flashdata, length);
+   else if (flashdata)
+      flash_sram_overflow = true;   /* buffer stays empty: never applied over the file */
+   free(flashdata);
+   flash_sram_dirty = false;
+}
+
+void flash_sram_frame_start(void)
+{
+   if (!flash_sram_pending)
+      return;
+   flash_sram_pending = false;
+   /* what the frontend loaded (its .srm) wins over the .flash file */
+   if (flash_data_ok(flash_sram, FLASH_SRAM_SIZE))
+      do_flash_read(flash_sram);
+   flash_sram_refresh();
+}
+
+void flash_sram_frame_end(void)
+{
+   if (flash_sram_dirty)
+      flash_sram_refresh();
+}
diff --git a/mednafen/ngp/flash.h b/mednafen/ngp/flash.h
index 7873e10..98e3f3d 100644
--- a/mednafen/ngp/flash.h
+++ b/mednafen/ngp/flash.h
@@ -36,6 +36,17 @@ int FLASH_StateAction(void *data, int load, int data_only);
 
 void do_flash_read(uint8_t *flashdata);
 
+/* Mosaik: the flash save is also exposed as RETRO_MEMORY_SAVE_RAM, so the frontend writes it
+   like any battery save (periodically, before sleep, on low battery, on exit) instead of
+   only when the game is unloaded. The buffer holds the .flash file format, zero padded. */
+#define FLASH_SRAM_SIZE 0x40000
+uint8_t *flash_sram_data(void);
+void flash_sram_refresh(void);        /* rebuild the buffer from the emulated flash */
+void flash_sram_frame_start(void);    /* first frame: apply what the frontend loaded */
+void flash_sram_frame_end(void);      /* after a frame: rebuild if the game wrote flash */
+/* checks a flash image (file, state or buffer) before it is applied */
+int flash_data_ok(const uint8_t *data, uint32_t len);
+
 #ifdef __cplusplus
 }
 #endif
