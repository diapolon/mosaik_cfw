+/* Mosaik: gamewatch closes the emulator with SIGTERM (exit from the menu, power off, low
+ * battery). Stop the emulation instead of dying, so the core writes the cartridge saves. */
+static void mosaik_stop(int sig)
+{
+    (void)sig;
+    if (CoreDoCommand != NULL)
+        (*CoreDoCommand)(M64CMD_STOP, 0, NULL);
+}
+
+/* Mosaik: "Save state" and "Load state" in the Mosaik menu over the game. gamewatch sends
+ * SIGUSR1 (save) or SIGUSR2 (load) after the menu closes; the core runs the job at the next
+ * frame, in the current slot (Saves/n64/state). */
+static void mosaik_state(int sig)
+{
+    if (CoreDoCommand != NULL)
+        (*CoreDoCommand)(sig == SIGUSR1 ? M64CMD_STATE_SAVE : M64CMD_STATE_LOAD, 0, NULL);
+}
+
+/* Mosaik: frames per second in the log every 10 s (Logs/linux-games.log), to see how fast each
+ * game runs on the console (60 is full speed for NTSC games, 50 for PAL). */
+static void mosaik_frame(unsigned int index)
+{
+    static unsigned int count;
+    static struct timespec start;
+    struct timespec t;
+    (void)index;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    if (start.tv_sec == 0) { start = t; count = 0; return; }
+    count++;
+    double dt = (double)(t.tv_sec - start.tv_sec) + (double)(t.tv_nsec - start.tv_nsec) / 1e9;
+    if (dt >= 10.0) {
+        /* a pause (Mosaik menu, sleep) stops the frames: that window is not a measure */
+        if (dt < 12.0) { printf("mupen64plus: %.1f fps\n", count / dt); fflush(stdout); }
+        start = t;
+        count = 0;
+    }
+}
