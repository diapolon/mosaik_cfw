#!/bin/sh
# Arcade M2 · sistema: prepara l'hardware come il firmware TrimUI e avvia il launcher.
# Dati, ROM, temi e core sono in /mnt/SDCARD/Arcade (la FAT della SD, leggibile dal Mac).
# Ogni passo va in Arcade/Logs/passi.txt con sync: se la console si riavvia si sa dove.
# Questo script è il processo 1: non deve mai terminare (il kernel andrebbe in panic).
# strato del modello: /run/fw punta a /fw/<modello> (lo crea l'initramfs). Schede preparate
# prima degli strati: si assume la Brick Pro
if [ ! -e /run/fw ]; then
    ln -s /fw/tg4040 /run/fw
    [ -f /run/trimui-model ] || echo "Trimui Brick Pro" > /run/trimui-model
fi
export PATH=/run/fw/bin:/usr/arcade/bin:/usr/bin:/usr/sbin:/bin:/sbin
export LD_LIBRARY_PATH=/run/fw/usr/trimui/lib:/run/fw/usr/lib:/run/fw/lib:/usr/lib:/lib
export ROOT=/mnt/SDCARD/Arcade HOME=/mnt/SDCARD/Arcade FB_TITLE=MOSAIK
export TRIMUI_MODEL="$(cat /run/trimui-model)" ARCADE_STANDALONE=1
# diagnostica facoltativa: Arcade/System/device-env.sh (vedi device-env.sh.esempio), per
# esempio TRIMUI_JOYDEBUG=1 (tasti nel log) o ARCADE_DEBUG_SHOT=1 (istantanea dei giochi)
[ -f "$ROOT/System/device-env.sh" ] && . "$ROOT/System/device-env.sh"
BIN=/usr/arcade/bin
# Registro diagnostico (Impostazioni > Strumenti): spento di base. Da spento i passi restano in
# memoria e sulla SD finiscono solo se l'avvio si blocca; le uscite dei programmi non si tengono.
DEBUG=$(sed -n 's/.*"debug_level": *\([0-9]\).*/\1/p' "$ROOT/System/settings.json" 2>/dev/null)
DEBUG=${DEBUG:-0}
if [ "$DEBUG" -ge 1 ]; then
    LOGDIR="$ROOT/Logs" LOG="$ROOT/Logs/avvio.log" INPUTLOG="$ROOT/Logs/inputd.log" LINUXLOG="$ROOT/Logs/linux-games.log"
else
    LOGDIR=/run/logs LOG=/dev/null INPUTLOG=/dev/null LINUXLOG=/dev/null
    mkdir -p "$LOGDIR"
fi
export ARCADE_LOG_DIR="$LOGDIR"
STEPS="$LOGDIR/passi.txt"
mkdir -p "$ROOT/Logs" "$ROOT/System" /tmp/trimui_inputd /dev/shm /dev/pts
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null

# Passi dell'avvio nel log. Niente sync a ogni passo (la SD è montata con "flush", che scrive
# subito; il sync si fa prima del launcher e negli errori) e niente messaggi a schermo per i
# passi normali: ognuno ridisegnava tutto lo schermo. step_show li mostra (errori e attese).
step() {
    echo "$(cut -d' ' -f1 /proc/uptime)s sistema: $1" >> "$STEPS"
}
step_show() {
    step "$1"
    sync
    fbmsg show blu 0 "$1" "$2" 2>/dev/null
}
# blocco finale: errore a schermo, log salvato, poi spegnimento (mai uscire dallo script)
halt_with() {
    step "ERRORE: $1"
    [ "$LOGDIR" = "$ROOT/Logs" ] || cp -f "$LOGDIR"/* "$ROOT/Logs"/ 2>/dev/null
    dmesg > "$ROOT/Logs/dmesg.txt"; sync
    fbmsg show rosso 60 "$1" "$2"
    sync; poweroff -f
    while :; do sleep 60; done
}

# log a rotazione: oltre 200 KB il file diventa .old (resta solo l'ultima copia)
for f in "$LOG" "$ROOT/Logs/Arcade.log" "$ROOT/Logs/linux-games.log"; do
    [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 200000 ] && mv -f "$f" "$f.old"
done

# Blocchi dell'intero sistema: un riavvio forzato cancella i messaggi del kernel. Con il registro
# acceso vanno sulla SD ogni secondo per il primo minuto; il segno resta se il giro non si chiude
# bene, e al giro dopo quei messaggi si conservano in kernel-blocco.txt.
KMARK="$ROOT/Logs/kernel-in-corso"
if [ "$DEBUG" -ge 1 ]; then
    [ -f "$KMARK" ] && [ -f "$ROOT/Logs/kernel.txt" ] && mv -f "$ROOT/Logs/kernel.txt" "$ROOT/Logs/kernel-blocco.txt"
    : > "$KMARK"
    ( i=0; while [ $i -lt 60 ]; do dmesg > "$ROOT/Logs/kernel.txt"; sync; i=$((i + 1)); sleep 1; done ) > /dev/null 2>&1 &
    KPID=$!
fi
# orologio della console in UTC (come nel firmware TrimUI); il fuso orario lo applica il launcher
hwclock -s -u 2>/dev/null
echo "=== $(date) · sistema Arcade M2 · $TRIMUI_MODEL" >> "$LOG"
# logo di avvio (lo stesso bootlogo.bmp che mostra U-Boot) al posto della schermata di prova,
# fino alla prima schermata del launcher
# Il logo di U-Boot sta nella radice della SD, fuori dagli aggiornamenti: quello giusto è nel
# sistema e si rimette al suo posto se è cambiato
cmp -s /run/fw/bootlogo.bmp /mnt/SDCARD/bootlogo.bmp || cp -f /run/fw/bootlogo.bmp /mnt/SDCARD/bootlogo.bmp 2>/dev/null
fbmsg logo /mnt/SDCARD/bootlogo.bmp 2>/dev/null
step "5 SISTEMA AVVIATO: $TRIMUI_MODEL ($(readlink /run/fw))"
/run/fw/hw-init.sh >> "$LOG" 2>&1 || step "preparazione hardware: errore"

# GPU PowerVR GE8300: i due moduli del firmware, in sottofondo mentre si preparano udev e
# tasti (prima erano in fila); i messaggi del kernel vanno in dmesg-gpu.txt
( insmod /run/fw/modules/pvrsrvkm.ko >> "$LOG" 2>&1 || step "pvrsrvkm: errore $?"
  insmod /run/fw/modules/dc_sunxi.ko >> "$LOG" 2>&1 || step "dc_sunxi: errore $?"
  dmesg | tail -40 > "$LOGDIR/dmesg-gpu.txt" ) &
GPU_JOB=$!

# avvio più rapido: il kernel con loglevel=8 scrive ogni messaggio sulla porta seriale.
# envtool scrive loglevel=4 nella copia di riserva dell'ambiente di U-Boot (quella in uso resta
# intatta finché la nuova non è valida); vale dal prossimo avvio
# solo sulla scheda da cui si è partiti, mai su un eventuale disco interno
SDDISK=$(awk '$2 == "/mnt/SDCARD" { print $1; exit }' /proc/mounts); SDDISK=${SDDISK#/dev/}; SDDISK=${SDDISK%p*}
envdev() { [ -n "$SDDISK" ] || return; for p in /sys/class/block/${SDDISK}p*; do grep -qx "PARTNAME=$1" "$p/uevent" 2>/dev/null && echo "/dev/${p##*/}"; done; }
E1=$(envdev env); E2=$(envdev env-redund)
if [ -n "$E1" ] && [ -n "$E2" ]; then
    r=$(envtool "$E1" "$E2" loglevel 4 2>&1)
    case $? in 0) step "ambiente di U-Boot: $r (vale dal prossimo avvio)" ;; 2) step "ambiente di U-Boot: $r" ;; esac
fi

# controllo della SD su richiesta: con Arcade/System/controlla-sd, fsck.fat in sola lettura
# (la SD è montata: è solo una diagnosi) e risultato in Logs/fsck-controllo.txt
if [ -f "$ROOT/System/controlla-sd" ]; then
    rm -f "$ROOT/System/controlla-sd"
    DEV=$(awk '$2 == "/mnt/SDCARD" { print $1 }' /proc/mounts)
    { echo "=== $(date) $DEV"; fsck.fat -n -v "$DEV"; echo "esito $?"; } > "$ROOT/Logs/fsck-controllo.txt" 2>&1
    sync
    step "controllo della SD: Logs/fsck-controllo.txt"
fi

# >>> nomi corti dopo il Mac (m2/test-fatnomi.sh prova questo blocco)
# nomi corti doppi lasciati dal driver FAT di macOS (m2/fatnomi.c): al primo spegnimento brusco
# fsck.fat ne rinominerebbe uno in FSCK0000.000 e il gioco perderebbe quel file. Si controllano
# a ogni avvio, prima del launcher, che non deve trovare un file a metà rinomina. Le tracce del
# Mac non bastano a capire se la scheda ci è passata: dopo una copia macOS cancella .fseventsd
# allo smontaggio (provato). fatnomi legge solo le cartelle; il tempo va nei passi.
SD=${SD:-/mnt/SDCARD}
t0=$(cut -d' ' -f1 /proc/uptime)
out=$(fatnomi "$SD" 2>&1); rc=$?
t1=$(cut -d' ' -f1 /proc/uptime)
if [ -n "$out" ]; then
    { echo "=== $(date)"; echo "$out"; echo "esito $rc"; } >> "$ROOT/Logs/nomi-corti.txt"
    sync
fi
step "nomi corti controllati in $(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.2f", b - a }') s: esito $rc, riparati $(printf '%s\n' "$out" | grep -c '^riparato:')"
# <<< nomi corti dopo il Mac

# crash del kernel registrati dal kernel stesso (pstore), per il blocco della Brick Pro col
# Wi-Fi (panico in sunxi_i2c_handler, issue trimui/firmware_brickpro#4). La partizione pstore
# è nella memoria interna: i rapporti si copiano soltanto, mai cancellati, e una volta sola
# (il nome ha l'impronta del contenuto).
if mount -t pstore pstore /sys/fs/pstore 2> /dev/null || grep -q ' /sys/fs/pstore ' /proc/mounts; then
    for f in /sys/fs/pstore/*; do
        [ -f "$f" ] || continue
        c="$ROOT/Logs/crash/${f##*/}-$(md5sum < "$f" | cut -c1-8).txt"
        [ -e "$c" ] && continue
        mkdir -p "$ROOT/Logs/crash" && cp "$f" "$c" && step "crash del kernel salvato: Logs/crash/${c##*/}"
    done
    sync
fi

# pulizia dei file che macOS lascia sulla SD copiando (._nome, .DS_Store; il launcher li
# ignora): in sottofondo e solo quando il launcher è già partito. Fatta durante l'avvio,
# centinaia di cancellazioni rallentavano i "sync" successivi (16 s al primo avvio).
( sleep 20
  n=$(find /mnt/SDCARD \( -name '._*' -o -name '.DS_Store' \) -type f 2>/dev/null | wc -l)
  if [ "$n" -gt 0 ]; then
      find /mnt/SDCARD \( -name '._*' -o -name '.DS_Store' \) -type f -delete 2>/dev/null
      step "pulizia: tolti $n file di macOS"
  fi ) &

# udev come nel firmware (/etc/init.d/udev): la SDL2 di TrimUI lo usa per trovare
# controller e audio
printf '\000\000\000\000' > /proc/sys/kernel/hotplug 2>/dev/null
udevd -d >> "$LOG" 2>&1 || step "udevd: errore"
udevadm trigger --type=subsystems --action=add
udevadm trigger --type=devices --action=add
udevadm settle --timeout=10 || step "udevadm settle: tempo scaduto"
step "5b UDEV AVVIATO"

# tasti e levette: il demone di TrimUI crea il gamepad "TRIMUI Player1" (già provato in M1)
[ -f "$ROOT/System/joypad.config" ] && cp "$ROOT/System/joypad.config" /mnt/UDISK/
[ -f "$ROOT/System/joypad_right.config" ] && cp "$ROOT/System/joypad_right.config" /mnt/UDISK/
trimui_inputd > "$INPUTLOG" 2>&1 &
# il gamepad deve comparire prima del launcher; se non arriva si riprova una volta
pad_ok() { grep -q "TRIMUI Player1" /proc/bus/input/devices; }
for i in $(seq 30); do pad_ok && break; sleep 0.2; done
if pad_ok; then
    step "6 TASTI PRONTI"
else
    step_show "6 GAMEPAD NON COMPARSO: trimui_inputd $(pidof trimui_inputd >/dev/null && echo attivo || echo terminato)" "RIAVVIO I TASTI"
    { echo "--- ps"; ps; echo "--- input"; cat /proc/bus/input/devices; ls -l /dev/uinput /dev/input; } >> "$INPUTLOG" 2>&1
    killall trimui_inputd 2>/dev/null; sleep 0.5
    trimui_inputd >> "$INPUTLOG" 2>&1 &
    for i in $(seq 50); do pad_ok && break; sleep 0.2; done
    pad_ok && step "6 TASTI PRONTI (secondo tentativo)" || step "6 TASTI ASSENTI"
fi
wait $GPU_JOB
step "9 GPU PRONTA"

# ---- audio
# Senza la preparazione del firmware la riproduzione resta ferma anche sull'hardware
# (aplay -D hw:0,0 non avanza). Si prova la scheda con un secondo di silenzio e, se non va,
# si cambia la configurazione dei controlli finché non va; tutto finisce in audio.txt.
AUDIO="$LOGDIR/audio.txt"
audio_test() { timeout -s KILL 3 aplay -q -D hw:0,0 -f S16_LE -r 48000 -c 2 -d 1 /dev/zero >/dev/null 2>&1; }
setc() { amixer -q cset name="$1" "$2" >> "$AUDIO" 2>&1 || echo "  (non riuscito: $1 = $2)" >> "$AUDIO"; }
{ echo "=== $(date)"; cat /proc/asound/cards; } > "$AUDIO" 2>&1
# altoparlante muto finché il launcher non ha aperto l'uscita audio: configurare il codec con
# l'amplificatore acceso fa rumore
[ -w /sys/class/speaker/mute ] && echo 1 > /sys/class/speaker/mute
step "9b AUDIO"
# configurazioni provate in ordine; quella che funziona si ricorda in System/audio.conf e
# agli avvii successivi si applica subito (una sola prova invece di quattro)
# comandi di ogni configurazione, uno per riga (per "amixer -s", che li esegue in una sola
# chiamata: lanciare amixer una volta per comando costava quasi un secondo all'avvio)
audio_lines() {
    case $1 in
    hub0) echo 'cset name="codec hub mode" 0' ;;
    hub1) echo 'cset name="codec hub mode" 1' ;;
    knulli) # valori di una Brick con audio funzionante (asound.state di Knulli)
        echo 'cset name="codec hub mode" 0'
        echo 'cset name="Headphone Switch" on'
        echo 'cset name="HpSpeaker Switch" on'
        echo 'cset name="LINEOUT Switch" on'
        echo 'cset name="LINEOUT Output Select" DAC_SINGLE'
        echo 'cset name="LINEOUT volume" 26' ;;
    esac
}
# uscite accese come nel firmware (altoparlante e cuffie); il volume lo regola il launcher
OUTPUTS='cset name="Headphone Switch" on
cset name="HpSpeaker Switch" on
cset name="LINEOUT Switch" on'
audio_apply() {
    audio_lines "$1" | amixer -q -s >> "$AUDIO" 2>&1 || echo "  (amixer -s: errore con $1)" >> "$AUDIO"
}
# verifica che la chiamata unica abbia funzionato; altrimenti i comandi uno alla volta
outputs_on() { amixer cget name="LINEOUT Switch" 2>/dev/null | grep -q ": values=on"; }
audio_apply_slow() {
    { audio_lines "$1"; echo "$OUTPUTS"; } | while read -r cmd; do
        eval "set -- $cmd"
        shift
        setc "${1#name=}" "$2"
    done
}
AUDIO_CONF="$ROOT/System/audio.conf"
saved=$(cat "$AUDIO_CONF" 2>/dev/null)
ok=0
# configurazione già trovata su questa scheda: si applica senza la prova (2 s risparmiati a
# ogni avvio). Per rifare la prova basta cancellare System/audio.conf.
if [ -n "$saved" ]; then
    { audio_lines "$saved"; echo "$OUTPUTS"; } | amixer -q -s >> "$AUDIO" 2>&1
    if outputs_on; then echo "configurazione ricordata ($saved): applicata senza prova" >> "$AUDIO"
    else echo "configurazione ricordata ($saved): amixer -s non riuscito, comandi uno alla volta" >> "$AUDIO"; audio_apply_slow "$saved"; fi
    ok=1
fi
if [ $ok = 0 ]; then
    { echo "--- controlli all'avvio"; amixer contents; } >> "$AUDIO" 2>&1
    # prima quella che funziona sulle console provate: le altre costano 3 secondi l'una se si
    # bloccano, e a schermo nero sembrerebbe una console guasta
    for cfg in knulli asis hub0 hub1; do
        audio_apply $cfg
        if audio_test; then echo "prova $cfg: riuscita" >> "$AUDIO"; ok=1; echo $cfg > "$AUDIO_CONF"; break; fi
        echo "prova $cfg: bloccata" >> "$AUDIO"
        [ -n "${WAIT_SHOWN:-}" ] || { step_show "PREPARO L'AUDIO" "PRIMA ACCENSIONE"; WAIT_SHOWN=1; }
    done
    if [ $ok = 1 ]; then step "9c AUDIO SISTEMATO ($(cat "$AUDIO_CONF"))"
    else step "9c AUDIO NON FUNZIONA: launcher e giochi senza audio"; export ARCADE_NO_AUDIO=1; rm -f "$AUDIO_CONF"; fi
    PROBED=1
fi
# uscite accese (nella prova; con la configurazione ricordata sono già nella chiamata unica)
[ -n "${PROBED:-}" ] && echo "$OUTPUTS" | amixer -q -s >> "$AUDIO" 2>&1
[ -n "${PROBED:-}" ] && { echo "--- controlli dopo la preparazione"; amixer contents; } >> "$AUDIO" 2>&1
arcade-suspend mute 2> /dev/null
: > /run/arcade-audio-held

# Brick Pro: interruzioni su processori diversi. trimui_inputd legge le levette dal bus I2C 3
# circa 500 volte al secondo, e il driver I2C del kernel va in panico quando una lettura scade
# mentre il Wi-Fi è attivo (issue trimui/firmware_brickpro#4, diapolon/mosaik_cfw#1). Con tutte
# le interruzioni sul processore 0, un blocco ogni ~30 accensioni del Wi-Fi; con il bus I2C 3 sul
# 3, il Wi-Fi sull'1 e i LED sul 2, uno ogni ~150; con anche trimui_inputd fermo mentre il Wi-Fi
# si accende (wifi-ctl), 200 su 200. Il chip Wi-Fi (xradio_irq) non si lascia spostare.
irq_cpu() {   # nome in /proc/interrupts, maschera dei processori
    n=$(awk -v n="$1" '$NF == n { sub(":", "", $1); print $1; exit }' /proc/interrupts)
    [ -n "$n" ] && echo "$2" > /proc/irq/$n/smp_affinity 2> /dev/null && echo "$1 $2"
}
if grep -q ' twi3$' /proc/interrupts; then
    step "interruzioni separate: $(irq_cpu twi3 8) · $(irq_cpu sunxi-mmc1 2) · $(irq_cpu ledcirq 4)"
fi

# prova a ripetizione del Wi-Fi (m2/prova-wifi), solo con System/prova-wifi.txt: il file si
# rinomina prima di cominciare, così se la console si blocca non si riparte da capo al riavvio
if [ -f "$ROOT/System/prova-wifi.txt" ]; then
    mv -f "$ROOT/System/prova-wifi.txt" "$ROOT/System/prova-wifi.in-corso"
    sync
    step "prova Wi-Fi: $(cat "$ROOT/System/prova-wifi.in-corso")"
    prova-wifi "$ROOT/System/prova-wifi.in-corso"
    mv -f "$ROOT/System/prova-wifi.in-corso" "$ROOT/System/prova-wifi.fatta"
    sync
    step "prova Wi-Fi finita: Logs/prova-wifi.txt"
fi

# Wi-Fi: se acceso nelle impostazioni, si avvia in sottofondo (il launcher lo accende e spegne)
if grep -q '"wifi": *true' "$ROOT/System/settings.json" 2>/dev/null || [ ! -f "$ROOT/System/settings.json" ]; then
    # dopo 15 secondi, a menu già pronto: tre blocchi della Brick Pro alla prima accensione dopo
    # una lunga pausa sono avvenuti tutti mentre il driver partiva insieme al launcher. Se nel
    # frattempo si è toccato il Wi-Fi dal menu vale quella scelta.
    ( sleep 15; [ -e /run/wifi-touched ] || wifi-ctl on ) > /dev/null 2>&1 &
fi

# rapporto per la diagnosi (Logs/sistema.txt), con il registro diagnostico "Prestazioni" o
# "Completo" (Impostazioni > Strumenti)
[ "$DEBUG" -ge 2 ] && ( sleep 10
  { echo "=== $(date)"; lsmod; echo; ps; echo
    echo "----- ingressi"; cat /proc/bus/input/devices; ls -l /dev/input
    for e in /dev/input/event*; do echo "--- udev: $e"; udevadm info -q property -n "$e"; done
    echo; echo "----- audio"; amixer scontrols; echo; tinymix 2>/dev/null | head -60
    echo; echo "----- led"; ls /sys/class/led_anim 2>&1
    cat /sys/class/led_anim/effect_names /sys/class/led_anim/help 2>&1
    for f in /sys/class/led_anim/max_scale* /sys/class/led_anim/effect_*; do echo "$f = $(cat $f 2>&1 | head -c 80)"; done
    echo; echo "----- wi-fi"; grep xradio /proc/modules; ifconfig -a; iw dev 2>/dev/null
    wpa_cli -p /run/wpa -i wlan0 status 2>/dev/null; ip route; cat /run/resolv.conf 2>/dev/null
    echo; ls -l /dev/pvr* /dev/dri 2>/dev/null; echo; dmesg | tail -80; } > "$ROOT/Logs/sistema.txt" 2>&1; sync ) &

# finish: chiude tutto e spegne; "finish reboot" riavvia (dopo un aggiornamento)
finish() {
    step "${1:-spegnimento}"
    # Wi-Fi e SD lavorano fino all'ultimo: con l'altoparlante acceso si sentirebbe un ronzio
    arcade-suspend mute 2> /dev/null
    [ -n "${KPID:-}" ] && kill "$KPID" 2> /dev/null
    rm -f "$KMARK"
    sync
    # SD smontata o in sola lettura: il kernel toglie il segno "in uso" dal FAT e al prossimo
    # avvio il controllo non serve (vedi initramfs-init). Prima si fermano i programmi che
    # hanno file aperti sulla SD (trimui_inputd scrive il suo log, un gioco può essere rimasto
    # in sottofondo): con un file aperto in scrittura il kernel non la chiude.
    wifi-ctl off > /dev/null 2>&1
    for sig in TERM KILL; do
        for p in /proc/[0-9]*; do
            pid=${p#/proc/}
            [ "$pid" = 1 ] || [ "$pid" = $$ ] && continue
            ls -l "$p/fd" 2>/dev/null | grep -q /mnt/SDCARD && kill -$sig "$pid" 2>/dev/null
        done
        sleep 0.3
    done
    sync
    # Prima la sola lettura, poi lo smontaggio. La SD è montata due volte: anche dall'initramfs,
    # che non può smontarla perché il sistema (squashfs) è un file sulla SD. Smontare solo
    # /mnt/SDCARD non basta: il kernel toglie il segno "in uso" quando il FAT diventa di sola
    # lettura o quando sparisce l'ultimo montaggio, e quello dell'initramfs resta.
    if mount -o remount,ro /mnt/SDCARD 2>/dev/null; then
        umount /mnt/SDCARD 2>/dev/null
    else
        { echo "SD non chiusa: controllo al prossimo avvio. File aperti:"
          ls -l /proc/[0-9]*/fd 2>/dev/null | grep /mnt/SDCARD; } >> "$STEPS"
        sync
    fi
    ${1:-poweroff} -f
    while :; do sleep 60; done
}

# Avvia un programma (launcher o runner) e ne attende la fine. I programmi scrivono il
# codice di uscita in System/exit.txt prima di chiudere SDL: se poi la chiusura si blocca
# (driver grafico o audio), dopo 6 secondi si termina il processo e vale quel codice (dopo
# una sospensione la chiusura della grafica può durare 3 secondi).
run_app() {
    rm -f "$ROOT/System/exit.txt"
    "$@" >> "$LOG" 2>&1 &
    pid=$!
    t=0
    while kill -0 $pid 2>/dev/null; do
        if [ -f "$ROOT/System/exit.txt" ]; then
            t=$((t + 1))
            if [ $t -ge 60 ]; then
                step "chiusura bloccata di $(basename "$1"): processo terminato"
                kill -9 $pid 2>/dev/null
                break
            fi
        fi
        sleep 0.1
    done
    wait $pid
    rc=$?
    if [ -f "$ROOT/System/exit.txt" ]; then
        code=$(cat "$ROOT/System/exit.txt")
        [ -n "$code" ] && rc=$code
        rm -f "$ROOT/System/exit.txt"
    fi
}

# Aggiornamento via Wi-Fi: il launcher toglie System/update-pending alla prima schermata. Se il
# sistema nuovo non ci arriva per 3 avvii di fila (o il launcher cade di continuo), si rimette
# il sistema precedente, tenuto come arcade-system.squashfs.prec.
SYSF="$ROOT/System/arcade-system.squashfs"
PENDING="$ROOT/System/update-pending"
rollback() {
    [ -f "$SYSF.prec" ] || return 1
    step "aggiornamento non riuscito: torno al sistema precedente"
    # il sistema può mancare se la corrente è saltata durante lo scambio dei file
    if { [ ! -f "$SYSF" ] || mv -f "$SYSF" "$SYSF.guasto"; } && mv -f "$SYSF.prec" "$SYSF"; then
        rm -f "$PENDING"
    else
        step "ritorno al sistema precedente non riuscito"
    fi
    sync
    finish reboot
}
# schede con la prima parte dell'avvio più vecchia: il conteggio si fa qui
if [ -f "$PENDING" ] && [ ! -f /run/boot-counted ]; then
    n=$(cat "$PENDING" 2>/dev/null)
    case $n in ''|*[!0-9]*) n=0 ;; esac   # file rovinato: un errore di calcolo chiuderebbe il processo 1
    n=$((n + 1))
    echo "$n" > "$PENDING"
    step "sistema appena aggiornato: avvio di prova $n"
    [ "$n" -gt 2 ] && rollback
fi
sync
fails=0
while :; do
    step "10 AVVIO DEL LAUNCHER"
    run_app "$BIN/launcher" --root "$ROOT"
    step "launcher: uscita $rc"
    case $rc in
    10) fails=0 ;;
    20) finish ;;
    21) finish reboot ;;
    *)  # nessun menu a cui tornare: si riavvia il launcher; se cade subito di continuo, errore
        fails=$((fails + 1))
        # il launcher è caduto: dalle impostazioni non si può più accendere il registro
        export ARCADE_LOG=1
        [ "$LOG" = /dev/null ] && LOG="$ROOT/Logs/avvio.log"
        if [ $fails -ge 5 ]; then
            [ -f "$PENDING" ] && rollback
            halt_with "IL LAUNCHER NON PARTE" "VEDI ARCADE/LOGS/ARCADE.LOG"
        fi
        sleep 1; continue ;;
    esac
    IFS="$(printf '\t')" read -r kind core rom title resume < "$ROOT/System/next.txt"
    rm -f "$ROOT/System/next.txt"
    if [ "$kind" = "linux" ]; then
        (
            cd "$(dirname "$rom")" || exit 1
            [ -f "$ROOT/System/linux-env.sh" ] && . "$ROOT/System/linux-env.sh"
            [ -f "$ROOT/System/next.env" ] && . "$ROOT/System/next.env"
            # titolo per il menu sopra il gioco (gamemenu)
            export ARCADE_TITLE="$title"
            exec "$BIN/gamewatch" -- sh "./$(basename "$rom")"
        ) >> "$LINUXLOG" 2>&1
        grc=$?
        rm -f "$ROOT/System/next.env"
        # 120: tasto di accensione tenuto premuto durante il gioco (gamewatch)
        [ $grc -eq 120 ] && finish
        continue
    fi
    set -- --root "$ROOT" --core "$core" --rom "$rom" --title "$title"
    [ "$resume" = "resume" ] && set -- "$@" --resume
    step "gioco: $title"
    run_app "$BIN/runner" "$@"
    step "runner: uscita $rc"
    [ $rc -eq 20 ] && finish
done
