#!/bin/busybox sh
# Arcade M2 · primo stadio (initramfs nell'immagine boot): trova la SD, monta il sistema
# (squashfs sulla FAT) e gli passa il controllo.
# Ogni passo va a schermo e in Arcade/Logs/passi.txt con sync subito dopo: se la console
# si riavvia, l'ultimo passo scritto dice dove si è fermata.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin FB_TITLE=MOSAIK
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
# il watchdog del kernel riavvia la console dopo ~20 s se nessuno lo alimenta;
# questo processo resta vivo anche dopo il passaggio al sistema
watchdog -t 2 -T 30 /dev/watchdog
# niente riavvio automatico se il kernel va in panic: meglio uno schermo fermo leggibile
echo 0 > /proc/sys/kernel/panic

P=""
STEPS=""
SD_LOGS=""
# passi nel log (a schermo resta il logo di U-Boot, poi il nostro: le schermate di prova a
# strisce compaiono solo per gli errori, rosse)
step() {
    echo "$(cut -d' ' -f1 /proc/uptime)s initramfs: $1" >> /tmp/passi.txt
    if [ -n "$STEPS" ]; then cat /tmp/passi.txt >> "$STEPS"; : > /tmp/passi.txt; fi
}
fail() {
    step "ERRORE: $1" "$2"
    # registro spento: i passi erano in memoria, ma un errore all'avvio va comunque sulla SD
    if [ -n "$SD_LOGS" ]; then
        cat /tmp/passi.txt >> "$SD_LOGS/passi.txt"
        dmesg > "$SD_LOGS/dmesg-initramfs.txt"
        sync
    fi
    fbmsg show rosso 60 "$1" "$2"
    sync
    poweroff -f
}

step "1 CERCO LA SD"
for t in $(seq 60); do
    # MOSAIK dalla 0.9.6; le schede scritte prima si chiamano ancora ARCADE
    P=$(findfs LABEL=MOSAIK 2>/dev/null || findfs LABEL=ARCADE 2>/dev/null) && break
    sleep 0.25
done
[ -n "$P" ] || fail "SD NON TROVATA" "MANCA LA PARTIZIONE MOSAIK"
mkdir -p /sd /root
# controllo del FAT prima di montarlo: spegnimenti bruschi lo possono danneggiare, e un FAT
# danneggiato impedisce di scrivere (per esempio il file che avvia i giochi)
# Il kernel segna il FAT "in uso" (bit 0 del byte 65 del settore di avvio) quando lo monta e
# toglie il segno quando lo smonta bene: il controllo serve solo se il segno è rimasto, cioè
# dopo uno spegnimento brusco. Con una SD grande il controllo legge decine di MB.
STATE=$(dd if="$P" bs=1 skip=65 count=1 2>/dev/null | od -An -tu1 | tr -d ' ')
if [ $(( ${STATE:-1} & 1 )) = 1 ]; then
    fbmsg show blu 0 "CONTROLLO LA SD" "" 2>/dev/null
    fsck.fat -a -w "$P" > /tmp/fsck.txt 2>&1
    FSCK=$?
else
    FSCK=skip
fi
# prima accensione: la partizione ARCADE si allarga fino alla fine della scheda (m2/sdgrow.c).
# Le volte successive sdgrow vede che non c'è nulla da fare e finisce subito.
PN=${P#/dev/}
DISK=/dev/$(basename "$(readlink -f /sys/class/block/$PN/..)")
GROW=1
if [ -f /sys/class/block/$PN/partition ] && [ -b "$DISK" ]; then
    sdgrow "$DISK" "$P" > /tmp/sdgrow.txt 2>&1
    GROW=$?
fi
if [ $GROW = 3 ]; then
    # partizione allargata ma il kernel vede ancora la misura vecchia: il FAT si allarga al
    # prossimo avvio
    fbmsg show blu 3 "SD ALLARGATA" "RIAVVIO" 2>/dev/null
    sync
    reboot -f
fi
# flush: i dati vanno sulla scheda appena un file è chiuso, non restano in memoria
mount -t vfat -o rw,noatime,flush "$P" /sd || fail "SD NON LEGGIBILE" "$P"
mkdir -p /sd/Arcade/Logs
SD_LOGS=/sd/Arcade/Logs
if grep -q '"debug_level": *[1-9]' /sd/Arcade/System/settings.json 2>/dev/null; then
    STEPS=$SD_LOGS/passi.txt
    [ -f "$STEPS" ] && [ "$(wc -c < "$STEPS")" -gt 100000 ] && mv -f "$STEPS" "$STEPS.old"
    echo "=== avvio $(date) · $(cat /proc/version)" >> "$STEPS"
fi
step "2 SD MONTATA" "$P"
fbmsg logo /sd/bootlogo.bmp 2>/dev/null
case $FSCK in
    skip) step "2b FAT chiuso bene all'ultimo spegnimento: controllo non necessario" ;;
    0) step "2b FAT: nessun errore" ;;
    1) step "2b FAT: errori corretti (dettagli in Logs/fsck.txt)"; cp /tmp/fsck.txt /sd/Arcade/Logs/fsck.txt; sync ;;
    *) step "2b FAT: controllo non riuscito ($FSCK, dettagli in Logs/fsck.txt)"; cp /tmp/fsck.txt /sd/Arcade/Logs/fsck.txt; sync ;;
esac
case $GROW in
    0) step "2c SD allargata a tutta la scheda: $(tr '\n' ' ' < /tmp/sdgrow.txt)" ;;
    1) ;;
    *) step "2c allargamento della SD non riuscito ($GROW): $(tr '\n' ' ' < /tmp/sdgrow.txt)" ;;
esac
# >>> scelta del sistema (m2/test-boot.sh prova questo blocco)
# strato del modello (driver GPU, librerie e programmi del firmware di questa console)
MID=$(sed -n 1p /etc/arcade-model 2>/dev/null); MNAME=$(sed -n 2p /etc/arcade-model 2>/dev/null)
SYS=/sd/Arcade/System/arcade-system.squashfs
# Aggiornamento: gli avvii di prova si contano qui, prima di usare il sistema nuovo, così vale
# anche se quello non riesce nemmeno a partire. Alla terza prova si torna al precedente.
PENDING=/sd/Arcade/System/update-pending
COUNTED=""
if [ -f "$PENDING" ]; then
    n=$(cat "$PENDING" 2>/dev/null)
    case $n in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    echo "$n" > "$PENDING"
    sync
    COUNTED=1
    step "sistema appena aggiornato: avvio di prova $n"
    if [ "$n" -gt 2 ] && [ -f "$SYS.prec" ]; then
        step "aggiornamento non riuscito: torno al sistema precedente"
        { [ ! -f "$SYS" ] || mv -f "$SYS" "$SYS.guasto"; } && mv -f "$SYS.prec" "$SYS" && rm -f "$PENDING"
        sync
    fi
fi
# corrente mancata proprio mentre l'aggiornamento scambiava i file: resta il sistema precedente
if [ ! -f "$SYS" ] && [ -f "$SYS.prec" ]; then
    step "sistema assente: uso il precedente"
    SYS=$SYS.prec
fi
[ -f "$SYS" ] || fail "MANCA IL SISTEMA" "ARCADE/SYSTEM/ARCADE-SYSTEM.SQUASHFS"
# montabile, con il programma di avvio e lo strato di questo modello
usable() {
    mount -t squashfs -o loop,ro "$1" /root || return 1
    [ -x /root/sbin/init ] && [ -d "/root/fw/$MID" ] && return 0
    umount /root
    return 1
}
if ! usable "$SYS"; then
    step "sistema non avviabile: provo il precedente"
    [ -f "$SYS.prec" ] && usable "$SYS.prec" || fail "SISTEMA NON AVVIABILE" "ARCADE/SYSTEM"
fi
# <<< scelta del sistema
step "3 SISTEMA MONTATO"
for d in tmp run var; do mount -t tmpfs -o mode=755 tmpfs /root/$d || fail "TMPFS" "$d"; done
mount -t tmpfs -o size=4m tmpfs /root/mnt/UDISK || fail "TMPFS" "UDISK"
[ -n "$COUNTED" ] && : > /root/run/boot-counted
ln -s /fw/$MID /root/run/fw
echo "$MNAME" > /root/run/trimui-model
step "4 PASSO AL SISTEMA" "$MNAME"
sync
umount /sd
mount -t vfat -o rw,noatime,flush "$P" /root/mnt/SDCARD || fail "RIMONTAGGIO SD"
mount --move /dev /root/dev
mount --move /proc /root/proc
mount --move /sys /root/sys
exec switch_root /root /sbin/init
