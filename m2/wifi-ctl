#!/bin/sh
# Wi-Fi del sistema Arcade (chip XR829 di Brick Pro e Smart Pro, driver xradio del firmware).
#   wifi-ctl on     carica il driver, avvia wpa_supplicant e wpa_cli (che a ogni connessione
#                   chiama wifi-event: indirizzo con udhcpc, ora con ntpd)
#   wifi-ctl off    ferma tutto e spegne l'interfaccia
# Le reti salvate sono in Arcade/System/wifi.conf (formato wpa_supplicant), sulla SD: restano
# anche aggiornando il sistema. Il launcher parla con wpa_supplicant via wpa_cli -p /run/wpa.
ROOT=${ROOT:-/mnt/SDCARD/Arcade}
CONF=$ROOT/System/wifi.conf
LOG=${ARCADE_LOG_DIR:-$ROOT/Logs}/wifi.log
CTRL=/run/wpa
EVPID=/run/wifi-event.pid
log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG"; }

# un comando alla volta: spegnere e riaccendere in fretta dal menu non deve sovrapporsi
# (flock: se un comando viene interrotto il blocco si libera da solo, e chi non lo ottiene non
# prosegue. I demoni avviati qui sotto non devono ereditare il descrittore 9, o lo terrebbero.)
exec 9> "${WIFI_LOCK:-/run/wifi-ctl.lock}"
i=0
until flock -n 9; do
    i=$((i + 1))
    if [ $i -ge ${WIFI_LOCK_TRIES:-200} ]; then   # 20 secondi, più di quanto duri un comando
        log "$1: altro comando Wi-Fi ancora in corso, rinuncio"
        exit 1
    fi
    sleep 0.1
done

# trimui_inputd fermo mentre il Wi-Fi si accende. Sulla Brick Pro legge le levette dal bus I2C 3
# circa 500 volte al secondo; il blocco è un panico del driver I2C del kernel quando una lettura
# scade mentre il Wi-Fi parte (issue trimui/firmware_brickpro#4). Con il bus fermo per quei pochi
# secondi il difetto non può scattare. SIGSTOP/SIGCONT: il programma non si chiude e una lettura
# già cominciata finisce prima. Riparte al collegamento, dopo 10 s o con "wifi-ctl off".
INPUTD_PAUSE=${WIFI_INPUTD_PAUSE:-/run/wifi-inputd-pausa}
inputd_pause() {
    [ "${WIFI_INPUTD:-1}" = 1 ] && [ -e "${WIFI_I2C:-/dev/i2c-3}" ] || return 0
    p=$(pidof trimui_inputd) || return 0
    printf '%s\n%s\n' "$1" "$p" > $INPUTD_PAUSE
    kill -STOP $p 2> /dev/null
}
inputd_resume() {   # $1: gettone dell'accensione, vuoto = qualunque
    [ -f $INPUTD_PAUSE ] || return 0
    [ -n "$1" ] && [ "$1" != "$(sed -n 1p $INPUTD_PAUSE)" ] && return 0
    kill -CONT $(sed -n 2p $INPUTD_PAUSE) 2> /dev/null
    rm -f $INPUTD_PAUSE
}

case "$1" in
resume)
    inputd_resume "$2"
    ;;
on)
    [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 100000 ] && mv -f "$LOG" "$LOG.old"
    tok=$$.$(cut -d' ' -f1 /proc/uptime)
    # il timer prima della pausa: anche se qualcosa va storto qui sotto, i tasti tornano
    ( sleep 10; exec "$0" resume "$tok" ) > /dev/null 2>&1 9>&- &
    inputd_pause "$tok"
    # dopo una sospensione manca solo xradio_wlan: si carica ciò che non c'è
    # (WIFI_MODULES: un'altra compilazione dello stesso driver, solo per m2/prova-wifi)
    for m in xradio_mac xradio_core xradio_wlan; do
        grep -q "^$m " /proc/modules && continue
        insmod "${WIFI_MODULES:-/run/fw/modules}/$m.ko" >> "$LOG" 2>&1 || log "insmod $m: errore"
    done
    for i in $(seq 50); do [ -e /sys/class/net/wlan0 ] && break; sleep 0.2; done
    if [ ! -e /sys/class/net/wlan0 ]; then
        log "wlan0 non comparsa"; dmesg | grep -i -E "xradio|xr829|sdio|mmc1" | tail -30 >> "$LOG"
        exit 1
    fi
    for k in /sys/class/rfkill/rfkill*; do
        [ "$(cat "$k/type" 2> /dev/null)" = wlan ] && echo 1 > "$k/state" 2> /dev/null
    done
    # anche se è vuoto: il controllo della SD svuota un file rimasto a metà dopo uno spegnimento
    # brusco, e senza update_config=1 wpa_supplicant non salverebbe più nessuna rete
    if [ ! -s "$CONF" ]; then
        printf 'ctrl_interface=%s\nupdate_config=1\n' "$CTRL" > "$CONF"
    fi
    ifconfig wlan0 up
    sleep 0.5   # come il firmware TrimUI: un attimo prima di wpa_supplicant
    mkdir -p "$CTRL"
    if ! pidof wpa_supplicant >/dev/null; then
        # stdout e stderr non sulla SD: allo spegnimento la SD non deve avere file aperti
        # disable_scan_offload: come il firmware, la ricerca delle reti non è affidata al driver
        echo disable_scan_offload=1 > /run/wpa-overlay.conf
        wpa_supplicant -B -i wlan0 -D nl80211 -c "$CONF" -I /run/wpa-overlay.conf -C "$CTRL" > /dev/null 2>&1 9>&- || { log "wpa_supplicant: errore"; exit 1; }
    fi
    # non "pidof wpa_cli": troverebbe anche i wpa_cli brevi con cui il launcher legge lo stato,
    # e senza questo processo nessuno chiederebbe l'indirizzo alla rete
    if ! { [ -f "$EVPID" ] && kill -0 "$(cat "$EVPID")" 2> /dev/null; }; then
        wpa_cli -B -P "$EVPID" -p "$CTRL" -i wlan0 -a /usr/arcade/bin/wifi-event > /dev/null 2>&1 9>&-
    fi
    log "Wi-Fi acceso"
    ;;
off)
    inputd_resume ""
    killall wpa_cli wpa_supplicant udhcpc 2>/dev/null
    for i in $(seq 25); do pidof wpa_supplicant > /dev/null || break; sleep 0.2; done
    # senza togliere l'indirizzo, alla riaccensione la console sembrerebbe già collegata
    ifconfig wlan0 0.0.0.0 2>/dev/null
    ifconfig wlan0 down 2>/dev/null
    rm -f /run/resolv.conf "$EVPID"
    log "Wi-Fi spento"
    ;;
*)
    echo "uso: wifi-ctl on|off|resume"; exit 2 ;;
esac
