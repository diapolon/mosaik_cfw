#!/bin/sh
# Bluetooth del sistema Arcade (chip XR829, lo stesso del Wi-Fi: HCI su UART ttyS1).
#   bt-ctl on                  accende il chip, D-Bus, bluetoothd, bluealsa; ricollega l'ultimo dispositivo
#   bt-ctl off                 salva gli abbinamenti e spegne tutto
#   bt-ctl auto                on per l'avvio e il risveglio: riprovato se il chip è occupato, salvo
#                              che l'interruttore nel frattempo dica spento
#   bt-ctl apply               accende o spegne secondo $BT_WANT (/run/bt-voluto, "on" o "off"),
#                              scritto dal launcher a ogni pressione dell'interruttore: un apply alla
#                              volta, e finché lo stato voluto cambia si ricomincia, così vince
#                              l'ultima pressione (audit 0.9.88, BT-05)
#   bt-ctl scan SECONDI        cerca, poi stampa i dispositivi (come "devices")
#   bt-ctl devices             dispositivi conosciuti, uno per riga:
#                              INDIRIZZO<tab>tipo<tab>abbinato<tab>collegato<tab>nome
#                              tipo: audio (cuffie), cassa, input, altro; abbinato e collegato: 0 o 1
#   bt-ctl pair INDIRIZZO      abbina, si fida e collega
#   bt-ctl connect|disconnect|forget INDIRIZZO
#   bt-ctl reconnect           ricollega l'ultimo dispositivo (6 tentativi, uno ogni 5 s)
#   bt-ctl status              "spento", oppure "acceso" e, se c'è, "collegato INDIRIZZO tipo nome"
#   bt-ctl diag                registro dell'audio verso le cuffie in Logs/bluetooth-audio.txt (lo fa
#                              watch la prima volta che l'audio passa alle cuffie, solo con BT_DIAG=1): catena ALSA, controlli,
#                              un suono di prova da "default" e uno diretto a bluealsa
#   bt-ctl watch               (lo avvia "on") ogni 4 s: audio verso le cuffie collegate o di nuovo
#                              all'altoparlante, anche quando le cuffie si spengono da sole
#
# Strada provata sulla Brick Pro con m2/prova-bt (docs locali STUDIO-BLUETOOTH):
# - hciattach -n ttyS1 xradio, fino a 3 tentativi con il chip spento e riacceso fra uno e l'altro;
#   sulla Brick Pro trimui_inputd fermo intanto (bus I2C 3, issue #1), e il blocco del Wi-Fi tenuto
#   (stesso chip: le due accensioni non si sovrappongono).
# - indirizzo fisso: hciattach ne inventa uno a ogni accensione (sulla Brick Pro non c'è
#   /sys/class/addr_mgt e xr_bt.conf lo fa fermare). Lo si dà col comando del fornitore 0xfc0a
#   (02 00 06 e i 6 byte al contrario), poi down/up perché il kernel lo rilegga. L'indirizzo è in
#   System/bluetooth/indirizzo.txt: ricavato dal numero di serie del SoC se c'è (resta uguale
#   cambiando scheda), se no a caso. Serve fisso: gli abbinamenti valgono per quell'indirizzo.
# - /var è un tmpfs dell'initramfs: /var/run → /run si crea qui (socket di D-Bus e di SDP).
# - abbinamenti: bluetoothd li tiene in /etc/lib/bluetooth/<adattatore>/<dispositivo> (→ /run/etc-lib);
#   la FAT non ammette ":" nei nomi, quindi sulla SD vanno in System/bluetooth/abbinamenti.tar,
#   scritto dopo ogni abbinamento, "dimentica" e spegnimento, e ripreso a ogni accensione.
#   Contiene le chiavi: come wifi.conf, non si vede dal trasferimento file.
# - audio: tutti i programmi usano il dispositivo ALSA "default" di /etc/asound.conf → /run/asound.conf
#   (copia di quello dello strato, /run/fw/asound.conf). Con cuffie o casse collegate si aggiunge un
#   pcm.!default verso bluealsa e /run/bt-audio dice a launcher e runner di riaprire l'audio;
#   scollegate, si rimette la copia. Il volume è quello di bluealsa ("<nome> - A2DP", come fa il
#   firmware TrimUI con amixer -D bluealsa): platform.c chiama "bt-ctl volume". Un softvol di ALSA
#   non va: il suo controllo resta bloccato dal programma che suona e gli altri non lo cambiano.
#   bt-ctl volume PERCENTO     volume delle cuffie collegate, 0..100
ROOT=${ROOT:-/mnt/SDCARD/Arcade}
DIR=$ROOT/System/bluetooth
TAR=$DIR/abbinamenti.tar
LAST=$DIR/ultimo.txt
LOG=${ARCADE_LOG_DIR:-$ROOT/Logs}/bluetooth.log
SYS=${BT_SYS:-/sys/class}
STORE=${BT_STORE:-/run/etc-lib/bluetooth}
RUN=${BT_RUN:-/run/bt}
BTWRITE=${BT_BTWRITE:-/proc/bluetooth/sleep/btwrite}
ASOUND=${BT_ASOUND:-/run/asound.conf}
ASOUND_BASE=${BT_ASOUND_BASE:-/run/fw/asound.conf}
AUDIO_FLAG=${BT_AUDIO_FLAG:-/run/bt-audio}
WANT=${BT_WANT:-/run/bt-voluto}
TZ=$(cat /run/arcade-tz "$ROOT/System/fuso-orario.txt" 2>/dev/null | head -n 1); [ -n "$TZ" ] && export TZ || unset TZ
log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG"; }
logs() { log "$@"; sync; }
mkdir -p "$RUN"

# un comando alla volta (come wifi-ctl); i demoni avviati qui non ereditano i descrittori 8 e 9
lock() {
    exec 9> "${BT_LOCK:-/run/bt-ctl.lock}"
    i=0
    until flock -n 9; do
        i=$((i + 1))
        # 75: blocco occupato, apply riprova (revisione della 0.9.92)
        [ $i -ge ${BT_LOCK_TRIES:-400} ] && { log "$1: altro comando Bluetooth ancora in corso, rinuncio"; exit 75; }
        sleep 0.1
    done
}

bt_on() { [ -d "$SYS/bluetooth/hci0" ] && pid_alive bluetoothd; }
# un file PID vuoto non è un processo vivo: in BusyBox "kill -0 ''" esce con 0
pid_alive() { p=$(cat "$RUN/$1.pid" 2> /dev/null); [ -n "$p" ] && kill -0 "$p" 2> /dev/null; }
pid_stop() {
    [ -f "$RUN/$1.pid" ] || return 0
    p=$(cat "$RUN/$1.pid")
    # PID vuoto: kill -0 "" in BusyBox esce con 0 e si aspettavano 2 s per niente (revisione della 0.9.99)
    [ -n "$p" ] || { rm -f "$RUN/$1.pid"; return 0; }
    kill "$p" 2> /dev/null
    for i in $(seq 20); do kill -0 "$p" 2> /dev/null || break; sleep 0.1; done
    kill -9 "$p" 2> /dev/null
    rm -f "$RUN/$1.pid"
}
start() {   # nome, comando...: in sottofondo, uscita nel registro
    # niente blocchi ai demoni: con l'8 (blocco del Wi-Fi, preso da chip_on) hciattach lo teneva
    # finché il Bluetooth restava acceso e wifi-ctl non partiva più (audit 0.9.88, BT-01)
    n=$1; shift
    "$@" >> "$LOG" 2>&1 8>&- 9>&- &
    echo $! > "$RUN/$n.pid"
}

rfkill_bt() {
    for k in "$SYS"/rfkill/rfkill*; do
        [ "$(cat "$k/type" 2> /dev/null)" = bluetooth ] && echo "$1" > "$k/state" 2> /dev/null
    done
    [ -e "$BTWRITE" ] && echo "$1" > "$BTWRITE" 2> /dev/null
}

address() {
    a=$(tr -d ' \r\n' 2> /dev/null < "$DIR/indirizzo.txt" | tr a-f A-F)
    echo "$a" | grep -q -E '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' && { echo "$a"; return; }
    serial=$(sed -n 's/.*serial[^:]*: *//p' "$SYS/sunxi_info/sys_info" 2> /dev/null | head -n 1)
    if [ -n "$serial" ] && [ "${serial#*[!0]}" != "$serial" ]; then
        h=$(printf 'mosaik-bt %s' "$serial" | md5sum | cut -c1-10); how="dal numero di serie"
    else
        h=$(hexdump -n 5 -e '5/1 "%02x"' /dev/urandom); how="a caso"
    fi
    a=$(echo "2C$h" | tr a-f A-F | sed 's/\(..\)/\1:/g; s/:$//')
    mkdir -p "$DIR" && echo "$a" > "$DIR/indirizzo.txt"
    logs "indirizzo nuovo ($how): $a"
    echo "$a"
}

# Brick Pro: trimui_inputd fermo solo mentre hciattach accende il chip (bus I2C 3, issue #1), un
# tentativo alla volta, con il segno $INPUTD_PAUSE che il launcher mostra come "tasti in pausa"; un
# trap lo fa ripartire anche se bt-ctl viene interrotto (audit 0.9.88, BT-07: prima restava fermo
# per tutti e tre i tentativi, fino a 36 s, senza avviso, e per sempre se bt-ctl moriva)
INPUTD_PAUSE=${BT_INPUTD_PAUSE:-/run/bt-inputd-pausa}
inputd=""
# segno e STOP/CONT sotto il blocco delle pause, lo stesso di m2/wifi-ctl (revisione della 0.9.99)
INPUTD_LOCK=${BT_INPUTD_LOCK:-/run/inputd-pausa.lock}
keys_stop() { [ -n "$inputd" ] || return 0; ( flock 5; : > "$INPUTD_PAUSE"; kill -STOP $inputd 2> /dev/null ) 5> "$INPUTD_LOCK"; }
# i tasti ripartono solo se li aveva fermati il Bluetooth e il Wi-Fi non li tiene fermi per la sua
# accensione (revisione della 0.9.92: li faceva ripartire nel mezzo della pausa del Wi-Fi, issue #1)
keys_go() {
    [ -f "$INPUTD_PAUSE" ] || return 0
    ( flock 5
      rm -f "$INPUTD_PAUSE"
      [ -n "$inputd" ] && [ ! -f "${BT_WIFI_PAUSE:-/run/wifi-inputd-pausa}" ] && kill -CONT $inputd 2> /dev/null ) 5> "$INPUTD_LOCK"
    return 0
}

chip_on() {
    # stesso chip del Wi-Fi: si aspetta che un'accensione del Wi-Fi in corso sia finita
    exec 8> "${BT_WIFI_LOCK:-/run/wifi-ctl.lock}"
    # al massimo 20 s; senza il blocco il chip non si tocca: prima, finita l'attesa, si accendeva lo
    # stesso mentre il Wi-Fi lo stava usando (audit Codex 0.9.100, A100-01). on esce con 75 e apply
    # riprova, così vale sempre l'ultima scelta dell'interruttore
    i=0; got=1
    until flock -n 8; do
        i=$((i + 1))
        [ $i -ge ${BT_WIFI_LOCK_TRIES:-200} ] && { got=0; break; }
        sleep 0.1
    done
    if [ $got = 0 ]; then
        exec 8>&-
        logs "chip occupato dal Wi-Fi da più di $((${BT_WIFI_LOCK_TRIES:-200} / 10)) s: non lo accendo"
        return 2
    fi
    [ "${BT_INPUTD:-1}" = 1 ] && [ -e "${BT_I2C:-/dev/i2c-3}" ] && inputd=$(pidof trimui_inputd)
    ok=1
    for t in 1 2 3; do
        # tasti fermi per tutto il tentativo, spegni e riaccendi del chip compreso, come nella 0.9.91;
        # e un hciattach senza risposta si ferma prima che ripartano (revisione della 0.9.102)
        keys_stop
        pid_stop hciattach
        rfkill_bt 0; sleep 1; rfkill_bt 1; sleep 1
        start hciattach hciattach -n ttyS1 xradio
        for i in $(seq ${BT_HCI_TRIES:-20}); do
            [ -d "$SYS/bluetooth/hci0" ] && break
            pid_alive hciattach || break
            sleep 0.5
        done
        [ -d "$SYS/bluetooth/hci0" ] || pid_stop hciattach
        keys_go
        [ -d "$SYS/bluetooth/hci0" ] && { ok=0; break; }
        logs "hciattach, tentativo $t: hci0 non comparso"
    done
    exec 8>&-
    [ $ok = 0 ] || return 1
    a=$(address)
    hciconfig hci0 up >> "$LOG" 2>&1
    hcitool -i hci0 cmd 0x3f 0x000a 02 00 06 $(echo "$a" | awk -F: '{ print $6, $5, $4, $3, $2, $1 }') > /dev/null 2>> "$LOG"
    hciconfig hci0 down >> "$LOG" 2>&1
    hciconfig hci0 up >> "$LOG" 2>&1
    got=$(hciconfig hci0 | sed -n 's/.*BD Address: \([0-9A-F:]*\).*/\1/p')
    [ "$got" = "$a" ] || logs "indirizzo non preso: il chip ha $got invece di $a"
    return 0
}

save() {
    [ -d "$STORE" ] || return 0
    mkdir -p "$DIR"
    # la cache dei dispositivi solo visti non serve: solo le cartelle dei dispositivi abbinati
    if tar -cf "$TAR.part" -C "$STORE" --exclude cache . 2>> "$LOG"; then
        mv -f "$TAR.part" "$TAR"; sync
    else
        rm -f "$TAR.part"; logs "abbinamenti non salvati"
    fi
}

# audio verso le cuffie ($1) o, senza argomento, di nuovo all'altoparlante
route() {
    if [ -n "$1" ]; then
        [ -f "$RUN/spegnimento" ] && return 0   # off in corso: resta l'altoparlante (BT-02)
        [ "$(cat "$AUDIO_FLAG" 2> /dev/null)" = "$1" ] && return 0
        {
            cat "$ASOUND_BASE"
            cat <<CONF

# Bluetooth (bt-ctl): cuffie $1
pcm.!default {
    type plug
    slave.pcm "bluealsa:DEV=$1,PROFILE=a2dp"
}
CONF
        } > "$ASOUND.part" && mv -f "$ASOUND.part" "$ASOUND" && echo "$1" > "$AUDIO_FLAG"
        log "audio verso le cuffie $1"
    else
        # anche senza il segno, se asound.conf non è quello dello strato: un route interrotto fra il
        # file e il segno lo lasciava verso bluealsa (revisione della 0.9.91)
        [ -f "$AUDIO_FLAG" ] || { [ -f "$ASOUND_BASE" ] && ! cmp -s "$ASOUND" "$ASOUND_BASE"; } || return 0
        cp -f "$ASOUND_BASE" "$ASOUND.part" && mv -f "$ASOUND.part" "$ASOUND"
        rm -f "$AUDIO_FLAG"
        log "audio di nuovo all'altoparlante"
    fi
}

# cuffie o casse abbinate e collegate in questo momento, vuoto se nessuna; con più di una, quella
# scelta per ultima (audit 0.9.88, BT-06), altrimenti la prima
connected_audio() {
    timeout 5 bluetoothctl paired-devices 2> /dev/null | describe | awk -F'\t' -v last="$(cat "$LAST" 2> /dev/null)" '
        ($2 == "audio" || $2 == "cassa") && $4 == 1 { if ($1 == last) { print $1; found = 1; exit } if (first == "") first = $1 }
        END { if (!found && first != "") print first }'
}
# indirizzi degli altri dispositivi audio collegati (tutti tranne $1)
other_audio() {
    timeout 5 bluetoothctl paired-devices 2> /dev/null | describe | awk -F'\t' -v me="$1" '($2 == "audio" || $2 == "cassa") && $4 == 1 && $1 != me { print $1 }'
}

# Connessioni in arrivo solo con un abbinamento (audit 0.9.88, BT-11): il kernel 4.9 del firmware ha i
# difetti Bluetooth del 2020 (BleedingTooth) e con la console connettibile chi è vicino poteva almeno
# farla cadere. L'abbinamento e il ricollegamento partono dalla console; con un abbinamento resta
# connettibile, perché molte cuffie si ricollegano da sole quando si accendono
connectable() {
    # bluetoothd non ancora pronto: il conteggio non riesce e si resta connettibili, se no le cuffie
    # abbinate non si ricollegherebbero da sole (revisione indipendente della 0.9.99)
    if ! timeout 3 bluetoothctl show 2> /dev/null | grep -q Controller; then v=on
    else
        n=$(timeout 5 bluetoothctl paired-devices 2> /dev/null | grep -c '^Device ')
        v=off; [ "${n:-0}" -gt 0 ] && v=on
    fi
    timeout 5 btmgmt connectable $v > /dev/null 2>&1 || log "connettibile $v: btmgmt non riuscito"
}

daemons_on() {
    [ -e /var/run ] || ln -s /run /var/run 2> /dev/null
    mkdir -p "$STORE" /run/dbus /run/bluetooth
    [ -f "$TAR" ] && [ -z "$(ls -A "$STORE" 2> /dev/null)" ] && { tar -xf "$TAR" -C "$STORE" 2>> "$LOG" || logs "abbinamenti illeggibili"; }
    printf '[General]\nName = Mosaik\nClass = 0x000100\nFastConnectable = true\n[Policy]\nAutoEnable = true\n' > /run/bluetooth/main.conf
    if ! pid_alive dbus; then
        cat > /run/dbus/mosaik.conf <<'CONF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=/run/dbus/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*" eavesdrop="true"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
CONF
        rm -f /run/dbus/system_bus_socket
        start dbus dbus-daemon --config-file=/run/dbus/mosaik.conf --nofork
        for i in $(seq 20); do [ -S /run/dbus/system_bus_socket ] && break; sleep 0.1; done
    fi
    pid_alive bluetoothd || start bluetoothd bluetoothd -n -f /run/bluetooth/main.conf
    for i in $(seq 30); do timeout 2 bluetoothctl show 2> /dev/null | grep -q Controller && break; sleep 0.2; done
    pid_alive bluealsa || start bluealsa bluealsa -p a2dp-source
    timeout 5 bluetoothctl power on > /dev/null 2>&1
    connectable
    pid_alive bluetoothd
}

# ultima riga "<campo>: valore" dell'uscita di info
field() { echo "$info" | sed -n "s/^[[:space:]]*$1: //p" | tail -n 1; }
# Volume delle cuffie a ogni collegamento: con un collegamento nuovo bluealsa riparte dal suo volume
# di partenza, più alto, e a rimettere quello scelto era solo il launcher; durante un gioco Linux o un
# emulatore a sé (Deadcast dopo il risveglio) restava alto (console, 20 novembre). "bt-ctl volume"
# ricorda l'ultimo valore in $RUN/volume; il controllo di bluealsa compare poco dopo il collegamento.
# Il valore si rilegge a ogni tentativo: uno scelto nel frattempo non torna quello di prima
# (revisione della 0.9.102)
volume_back() {
    for i in 1 2 3 4 5 6; do
        v=$(cat "$RUN/volume" 2> /dev/null); [ -n "$v" ] || return 0
        sh "$0" volume "$v" > /dev/null 2>&1 9>&- && return 0
        sleep ${BT_VOLUME_WAIT:-0.5}
    done
    log "volume $v non rimesso: controllo di bluealsa non trovato"
}

# righe "Device INDIRIZZO nome" → righe per il launcher
describe() {
    while read -r w a name; do
        [ "$w" = Device ] || continue
        echo "$a" | grep -q -E '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || continue
        info=$(timeout 3 bluetoothctl info "$a" 2> /dev/null)
        # un nome con "a capo" aggiunge righe finte all'uscita di info (audit 0.9.88, BT-13): il nome
        # è la prima riga Name, senza caratteri di controllo; gli altri campi vengono dopo Name e
        # Alias, quindi vale la loro ultima riga
        n=$(echo "$info" | sed -n 's/^[[:space:]]*Name: //p' | head -n 1 | tr -d '\000-\037\177')
        [ -z "$n" ] && continue
        case "$(field Icon)" in
            audio*)
                # casse e cuffie: dalla classe del dispositivo (Bluetooth Assigned Numbers, audio/video:
                # 5 altoparlante, 7 audio portatile, 8 auto, 10 HiFi; il resto cuffie e auricolari)
                cls=$(field Class)
                case "$cls" in 0x[0-9a-fA-F]*) ;; *) cls=0 ;; esac
                case "$cls" in 0x*[!0-9a-fA-F]*) cls=0 ;; esac
                case "$(( (cls >> 2) & 63 ))" in 5|7|8|10) k=cassa ;; *) k=audio ;; esac ;;
            input*) k=input ;; *) k=altro ;;
        esac
        p=0; [ "$(field Paired)" = yes ] && p=1
        c=0; [ "$(field Connected)" = yes ] && c=1
        printf '%s\t%s\t%s\t%s\t%s\n' "$a" "$k" "$p" "$c" "$n"
    done
}
# Tutti i dispositivi visti: "info" su ognuno (anche 30 dopo una ricerca, mezzo secondo l'uno)
# rendeva l'elenco vecchio di 10 s e oltre (cuffie scollegate che restavano "collegato"). Lo stato
# cambia solo per gli abbinati, che si leggono sempre; per gli altri tipo e nome si tengono in
# $RUN/visti/<indirizzo> (riga vuota = da non mostrare) finché il Bluetooth resta acceso.
devices() {
    paired=$(timeout 5 bluetoothctl paired-devices 2> /dev/null | awk '$1 == "Device" { print $2 }')
    mkdir -p "$RUN/visti"
    timeout 5 bluetoothctl devices 2> /dev/null | while read -r w a name; do
        [ "$w" = Device ] || continue
        echo "$a" | grep -q -E '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || continue
        if echo "$paired" | grep -qx "$a"; then
            echo "Device $a" | describe
        elif [ -f "$RUN/visti/$a" ]; then
            grep . "$RUN/visti/$a"
        else
            echo "Device $a" | describe | tee "$RUN/visti/$a"
        fi
    done
}
# una ricerca in corso rallenta abbinamento e collegamento: la si ferma prima
stop_scan() {
    pgrep -f "bluetoothctl --timeout" > /dev/null || return 0
    pkill -f "bluetoothctl --timeout" 2> /dev/null; timeout 3 bluetoothctl scan off > /dev/null 2>&1; sleep 1
}
valid() { echo "$1" | grep -q -E '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || { echo "indirizzo non valido: $1" >&2; exit 2; }; }
connected_line() { timeout 5 bluetoothctl paired-devices 2> /dev/null | describe | awk -F'\t' '$4 == 1 { print; exit }'; }

case "$1" in
on)
    lock on
    # il launcher mostra "in accensione" finché c'è questo file
    : > "$RUN/avvio"; trap 'keys_go; rm -f "$RUN/avvio"' EXIT; trap 'exit 1' INT TERM
    [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 100000 ] && mv -f "$LOG" "$LOG.old"
    if bt_on; then log "già acceso"; exit 0; fi
    if [ ! -d "$SYS/bluetooth/hci0" ]; then
        chip_on; r=$?
        [ $r = 2 ] && { logs "Bluetooth NON acceso: chip occupato dal Wi-Fi"; exit 75; }
        if [ $r != 0 ]; then
            rfkill_bt 0; pid_stop hciattach
            logs "Bluetooth NON acceso: il chip non risponde"
            exit 1
        fi
    fi
    if ! daemons_on; then
        logs "Bluetooth NON acceso: bluetoothd non parte"
        exit 1
    fi
    logs "Bluetooth acceso"
    rm -f "$RUN/spegnimento"
    # i PID prima di lasciare il blocco: un off che arriva subito li trova e ferma i due processi
    # (revisione della 0.9.91); i figli non tengono il blocco (9>&-)
    [ -s "$LAST" ] && { sh "$0" reconnect > /dev/null 2>&1 9>&- & echo $! > "$RUN/reconnect.pid"; }
    pid_alive watch || { sh "$0" watch > /dev/null 2>&1 9>&- & echo $! > "$RUN/watch.pid"; }
    flock -u 9
    exit 0
    ;;
off)
    lock off
    # niente più audio verso le cuffie da qui in poi: un ricollegamento o un collegamento che finisce
    # mentre si spegne rimandava l'audio a bluealsa ormai fermo e la console restava muta (BT-02)
    : > "$RUN/spegnimento"
    pid_stop watch; pid_stop reconnect
    save
    timeout 5 bluetoothctl power off > /dev/null 2>&1
    pid_stop bluealsa; pid_stop bluetoothd; pid_stop dbus
    route
    rm -rf "$RUN/visti"
    hciconfig hci0 down > /dev/null 2>&1
    pid_stop hciattach
    rfkill_bt 0
    rm -f /run/dbus/system_bus_socket "$RUN/collegato"
    logs "Bluetooth spento"
    ;;
scan)
    # aperta la finestra subito dopo aver acceso il Bluetooth: la ricerca aspetta che sia pronto
    # (prima finiva subito e bisognava premere Cerca una seconda volta)
    i=0; while ! bt_on && [ $i -lt ${BT_SCAN_WAIT:-60} ]; do sleep 0.5; i=$((i + 1)); done
    bt_on || { echo "spento" >&2; exit 1; }
    s=${2:-10}; case "$s" in *[!0-9]*|'') s=10 ;; esac
    # i dispositivi visti senza nome si riguardano a ogni ricerca: il nome può arrivare dopo
    for f in "$RUN"/visti/*; do [ -s "$f" ] || rm -f "$f"; done
    timeout $((s + 5)) bluetoothctl --timeout "$s" scan on > /dev/null 2>&1
    devices
    ;;
devices)
    bt_on || exit 0
    devices
    ;;
pair)
    valid "$2"; bt_on || { echo "spento" >&2; exit 1; }
    stop_scan
    # con la radio appena libera dalla ricerca il primo tentativo può non trovare le cuffie
    # (ConnectionAttemptFailed, Smart Pro 19 novembre): un secondo tentativo dopo 2 s
    for t in 1 2; do
        out=$(timeout 40 bluetoothctl --agent NoInputNoOutput pair "$2" 2>&1)
        echo "$out" | grep -q -E 'Pairing successful|AlreadyExists' && break
        echo "$out" | grep -q -E 'ConnectionAttemptFailed|Page Timeout|not available' || break
        log "abbinamento con $2, tentativo $t: $(echo "$out" | tail -n 1)"
        sleep 2
    done
    if ! echo "$out" | grep -q -E 'Pairing successful|AlreadyExists'; then
        logs "abbinamento con $2 non riuscito: $(echo "$out" | tail -n 1)"; echo "non riuscito" >&2; exit 1
    fi
    timeout 5 bluetoothctl trust "$2" > /dev/null 2>&1
    lock pair; save; flock -u 9
    connectable
    logs "abbinato $2"
    exec sh "$0" connect "$2"
    ;;
connect)
    valid "$2"; bt_on || { echo "spento" >&2; exit 1; }
    stop_scan
    out=$(timeout 30 bluetoothctl connect "$2" 2>&1)
    if echo "$out" | grep -q 'Connection successful'; then
        mkdir -p "$DIR"; echo "$2" > "$LAST"; echo "$2" > "$RUN/collegato"
        logs "collegato $2"
        volume_back
        # un'uscita audio alla volta: collegate cuffie o cassa, le altre si scollegano (BT-06); un
        # controller non scollega niente
        if [ -n "$(echo "Device $2" | describe | awk -F'\t' '$2 == "audio" || $2 == "cassa"')" ]; then
            for o in $(other_audio "$2"); do
                timeout 10 bluetoothctl disconnect "$o" > /dev/null 2>&1 && log "scollegato $o: ora l'audio va a $2"
            done
        fi
        a=$(connected_audio); [ -n "$a" ] && route "$a"
    else
        logs "collegamento con $2 non riuscito: $(echo "$out" | tail -n 1)"; echo "non riuscito" >&2; exit 1
    fi
    ;;
disconnect)
    valid "$2"; bt_on || exit 0
    timeout 10 bluetoothctl disconnect "$2" > /dev/null 2>&1
    rm -f "$RUN/collegato"
    route "$(connected_audio)"
    log "scollegato $2"
    ;;
forget)
    valid "$2"; bt_on || { echo "spento" >&2; exit 1; }
    timeout 10 bluetoothctl remove "$2" > /dev/null 2>&1
    [ "$(cat "$LAST" 2> /dev/null)" = "$2" ] && rm -f "$LAST"
    [ "$(cat "$RUN/collegato" 2> /dev/null)" = "$2" ] && rm -f "$RUN/collegato"
    route "$(connected_audio)"
    lock forget; save
    connectable
    logs "dimenticato $2"
    ;;
reconnect)
    # il PID lo tiene off per fermarlo: finito qui, il file va tolto (un PID vecchio potrebbe
    # essere già di un altro processo)
    trap '[ "$(cat "$RUN/reconnect.pid" 2> /dev/null)" = $$ ] && rm -f "$RUN/reconnect.pid"' EXIT
    a=$(cat "$LAST" 2> /dev/null); [ -n "$a" ] || exit 0
    for t in 1 2 3 4 5 6; do
        bt_on || exit 1
        timeout 5 bluetoothctl info "$a" 2> /dev/null | grep -q 'Connected: yes' && { echo "$a" > "$RUN/collegato"; route "$(connected_audio)"; exit 0; }
        timeout 15 bluetoothctl connect "$a" 2>&1 | grep -q 'Connection successful' && { echo "$a" > "$RUN/collegato"; logs "ricollegato $a"; route "$(connected_audio)"; volume_back; exit 0; }
        sleep ${BT_RECONNECT_WAIT:-5}
    done
    log "ricollegamento a $a non riuscito"
    exit 1
    ;;
volume)
    p=$2; case "$p" in ''|*[!0-9]*) echo "uso: bt-ctl volume 0..100" >&2; exit 2 ;; esac
    [ "$p" -gt 100 ] && p=100
    mkdir -p "$RUN"; echo "$p" > "$RUN/volume"   # lo rimette volume_back a ogni collegamento
    c=$(amixer -D bluealsa scontrols 2> /dev/null | sed -n "s/^Simple mixer control '\(.*\)',[0-9]*$/\1/p" | grep -- '- A2DP' | head -n 1)
    [ -n "$c" ] || exit 1
    # fra apici: senza, amixer legge una virgola nel nome come separatore dell'indice (BT-20)
    case "$c" in *"'"*) id="\"$c\"" ;; *) id="'$c'" ;; esac
    amixer -q -M -D bluealsa sset "$id" "$p%" 2> /dev/null
    ;;
diag)
    D=${ARCADE_LOG_DIR:-$ROOT/Logs}/bluetooth-audio.txt
    a=$(cat "$AUDIO_FLAG" 2> /dev/null)
    {
        echo "=== $(date) · cuffie: ${a:-nessuna}"
        echo "--- /etc/asound.conf"; ls -l /etc/asound.conf "$ASOUND"; tail -18 "$ASOUND"
        echo "--- aplay -L (bluealsa e default)"; aplay -L 2>&1 | grep -i -E -A1 "^(default|bluealsa|sysdefault)" | head -20
        echo "--- controlli"; amixer controls 2>&1 | grep -i -E "blue|soft|digital volume"
        echo "--- flusso del codec"; cat /proc/asound/audiocodec/pcm0p/sub0/status 2>&1 | head -4
        echo "--- chi usa l'audio"; for p in /proc/[0-9]*; do ls -l "$p/fd" 2> /dev/null | grep -q /dev/snd && echo "$(basename "$p") $(tr '\0' ' ' < "$p/cmdline" | cut -c1-80)"; done
        echo "--- suono di prova da default (aplay -v)"; timeout 8 aplay -v -D default /usr/arcade/share/prova-bt.wav 2>&1 | head -60; echo "uscita $?"
        echo "--- volume di bluealsa"; amixer -D bluealsa scontents 2>&1 | head -12
        [ -n "$a" ] && { echo "--- suono di prova diretto a bluealsa"; timeout 8 aplay -D "bluealsa:DEV=$a,PROFILE=a2dp" /usr/arcade/share/prova-bt.wav 2>&1 | tail -5; echo "uscita $?"; }
        echo "--- bluealsa"; pid_alive bluealsa && echo "in funzione" || echo "NON in funzione"
    } >> "$D" 2>&1
    sync
    ;;
auto)
    # avvio e risveglio: on, riprovato se il chip resta al Wi-Fi o un altro comando tiene il blocco
    # (uscita 75), finché l'interruttore non dice spento; prima un on rinunciava e il Bluetooth
    # restava spento con l'impostazione accesa (revisione della 0.9.102)
    for t in 1 2 3 4 5 6; do
        [ "$(cat "$WANT" 2> /dev/null)" = off ] && exit 0
        sh "$0" on; r=$?
        [ $r = 75 ] || exit $r
        sleep ${BT_RETRY_WAIT:-5}
    done
    logs "Bluetooth non acceso all'avvio o al risveglio: chip sempre occupato"
    exit 75
    ;;
apply)
    exec 7> "$RUN/apply.lock"
    flock 7
    busy=0
    while :; do
        w=$(cat "$WANT" 2> /dev/null)
        rc=0
        case "$w" in
            on) bt_on || { sh "$0" on > /dev/null 2>&1 7>&-; rc=$?; } ;;
            # anche col chip già sparito, se resta acceso qualcosa (revisione della 0.9.92)
            off) if [ -d "$SYS/bluetooth/hci0" ] || pid_alive bluetoothd || pid_alive bluealsa || pid_alive dbus \
                    || pid_alive hciattach || pid_alive watch; then sh "$0" off > /dev/null 2>&1 7>&-; rc=$?; fi ;;
        esac
        # blocco occupato da un on lungo (avvio, risveglio): si riprova, se no l'interruttore resterebbe
        # su spento col Bluetooth acceso (revisione della 0.9.92)
        if [ $rc = 75 ] && [ $busy -lt 5 ]; then busy=$((busy + 1)); sleep 1; continue; fi
        [ "$(cat "$WANT" 2> /dev/null)" = "$w" ] && break
    done
    ;;
watch)
    # uscito da solo (il chip sparito): il PID non deve restare, potrebbe diventare di un altro processo
    trap '[ "$(cat "$RUN/watch.pid" 2> /dev/null)" = $$ ] && rm -f "$RUN/watch.pid"' EXIT
    # le cuffie possono spegnersi o ricollegarsi da sole: l'audio le segue
    # bluetoothd o bluealsa fermi: si fanno ripartire; senza bluealsa l'audio intanto torna
    # all'altoparlante, se no resterebbe indirizzato a lui e tutto muto (audit 0.9.88, BT-08)
    # Revisione della 0.9.92: anche D-Bus, senza il quale bluetoothd esce subito; al massimo 3
    # ripartenze in 5 minuti (prima: una ogni giro, per sempre, con un sync della SD ciascuna); il
    # blocco del servizio intorno a ogni ripartenza, così non si sovrappone a un on o un off; e dopo
    # bluetoothd o bluealsa nuovi le cuffie si ricollegano, perché il flusso A2DP di prima non c'è più.
    diag_done="" restarts=0 gaveup="" again=""
    t0=$(cut -d. -f1 /proc/uptime)
    exec 9> "${BT_LOCK:-/run/bt-ctl.lock}"
    # una ripartenza per ogni guasto, anche se ripartono D-Bus, bluetoothd e bluealsa insieme (prima
    # una caduta di D-Bus ne contava due e alla seconda il Bluetooth restava spento); con il blocco
    # occupato (un on o un off in corso) non si conta niente e si riprova al giro dopo (revisione
    # indipendente della 0.9.99)
    revive() {
        flock -n 9 || return 1
        now=$(cut -d. -f1 /proc/uptime)
        [ $((now - t0)) -gt 300 ] && { t0=$now; restarts=0; }
        [ -n "$gaveup" ] && { flock -u 9; return 1; }
        restarts=$((restarts + 1))
        if [ $restarts -gt ${BT_RESTARTS:-3} ]; then
            gaveup=1; logs "servizi del Bluetooth fermi più volte: smetto di farli ripartire (riaccendi il Bluetooth)"
            flock -u 9
            return 1
        fi
        return 0
    }
    # dopo aver rinunciato la guardia esce (l'audio torna all'altoparlante): riaccendendo il
    # Bluetooth on ne avvia una nuova; prima restava viva e inerte (revisione della 0.9.102)
    while [ -d "$SYS/bluetooth/hci0" ] && [ ! -f "$RUN/spegnimento" ] && [ -z "$gaveup" ]; do
        if { ! pid_alive dbus || ! pid_alive bluetoothd || ! pid_alive bluealsa; } && revive; then
          if ! pid_alive dbus; then
            logs "D-Bus fermo: riparte"
            rm -f /run/dbus/system_bus_socket
            start dbus dbus-daemon --config-file=/run/dbus/mosaik.conf --nofork
            for i in $(seq 20); do [ -S /run/dbus/system_bus_socket ] && break; sleep 0.1; done
            pid_alive bluetoothd && { pid_stop bluetoothd; pid_stop bluealsa; }   # erano collegati al D-Bus fermo
          fi
          if ! pid_alive bluetoothd; then
            logs "bluetoothd fermo: riparte"
            a=$(cat "$AUDIO_FLAG" 2> /dev/null)
            route
            start bluetoothd bluetoothd -n -f /run/bluetooth/main.conf
            for i in $(seq 30); do timeout 2 bluetoothctl show 2> /dev/null | grep -q Controller && break; sleep 0.2; done
            timeout 5 bluetoothctl power on > /dev/null 2>&1
            connectable
            pid_stop bluealsa; start bluealsa bluealsa -p a2dp-source
            again=${a:-$(cat "$LAST" 2> /dev/null)}
          elif ! pid_alive bluealsa; then
            logs "bluealsa fermo: riparte"
            a=$(cat "$AUDIO_FLAG" 2> /dev/null)
            route
            start bluealsa bluealsa -p a2dp-source
            sleep 1
            again=$a
          fi
          flock -u 9
        fi
        if [ -n "$again" ]; then   # cuffie ricollegate al servizio nuovo
            timeout 10 bluetoothctl disconnect "$again" > /dev/null 2>&1; sleep 1
            timeout 15 bluetoothctl connect "$again" > /dev/null 2>&1 && volume_back
            again=""
        fi
        route "$(connected_audio)"
        # diagnosi solo se chiesta (BT_DIAG=1): suona due melodie di prova (audit 0.9.88, BT-14)
        if [ -f "$AUDIO_FLAG" ] && [ -z "$diag_done" ] && [ "${BT_DIAG:-0}" = 1 ]; then
            diag_done=1; sleep 3; sh "$0" diag > /dev/null 2>&1
        fi
        sleep ${BT_WATCH_EVERY:-4}
    done
    route
    ;;
status)
    bt_on || { echo spento; exit 0; }
    echo acceso
    c=$(connected_line)
    if [ -n "$c" ]; then
        echo "$c" | awk -F'\t' '{ print "collegato " $1 " " $2 " " $5 }'
        echo "$c" | cut -f1 > "$RUN/collegato"
    else
        rm -f "$RUN/collegato"
    fi
    ;;
*)
    echo "uso: bt-ctl on|off|apply|scan [SECONDI]|devices|pair|connect|disconnect|forget INDIRIZZO|reconnect|status|watch|volume|diag"; exit 2 ;;
esac
