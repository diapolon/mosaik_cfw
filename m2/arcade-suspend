#!/bin/sh
# Sospensione della console, come keymon e /sbin/suspendtomem.sh del firmware TrimUI:
# si fermano Wi-Fi e LED, si avvisa trimui_inputd (/tmp/system_suspend: gestisce la
# retroilluminazione), si scrive tutto sulla SD e si sospende in RAM. Il tasto di accensione
# risveglia la console: lo script riprende da "echo mem" e rimette le cose com'erano.
# Lo chiama il launcher o il runner (plat_suspend), che restano fermi finché non torna.
ROOT=${ROOT:-/mnt/SDCARD/Arcade}
LOGDIR=${ARCADE_LOG_DIR:-$ROOT/Logs}
STEPS=$LOGDIR/passi.txt
step() { echo "$(cut -d' ' -f1 /proc/uptime)s sospensione: $1" >> "$STEPS"; }

wifi=0
pidof wpa_supplicant > /dev/null && wifi=1
step "inizio (wi-fi $([ $wifi = 1 ] && echo acceso || echo spento))"
# Wi-Fi: una ricerca di reti in corso fa rifiutare la sospensione al driver ("phy0 failed to
# suspend: error -16"): si interrompe, si spegne e si blocca la radio (rfkill) come keymon
if [ $wifi = 1 ]; then
    wpa_cli -p /run/wpa -i wlan0 abort_scan > /dev/null 2>&1
    wifi-ctl off > /dev/null 2>&1
fi
for k in /sys/class/rfkill/rfkill*; do
    [ "$(cat "$k/type" 2> /dev/null)" = wlan ] && echo 0 > "$k/state" 2> /dev/null
done
echo 0 > /sys/class/led_anim/enable 2> /dev/null
# audio muto prima di dormire: al risveglio il codec si riavvia e l'amplificatore farebbe un "crack"
[ -w /sys/class/speaker/mute ] && echo 1 > /sys/class/speaker/mute
for c in "Headphone Switch" "HpSpeaker Switch" "LINEOUT Switch"; do amixer -q cset name="$c" off 2> /dev/null; done
touch /tmp/system_suspend
sync

# Il rilascio del tasto è esso stesso un evento di risveglio: si lascia passare mezzo secondo.
# wakeup_count: se arriva un evento di risveglio mentre ci si prepara, la scrittura fallisce
# e si riprova. Se il kernel annulla la sospensione (un dispositivo rifiuta, o un evento di
# risveglio arriva a metà) si riprova fino a 5 volte; i messaggi del kernel di ogni tentativo
# fallito vanno in Logs/sospensione.txt.
sleep 0.5
r="non riuscita"
tries=0
# Spegnere i dispositivi richiede 2-3 secondi e lo schermo si spegne subito: se in quel tempo si
# preme il tasto di accensione, il kernel annulla la sospensione. È un risveglio voluto, da non
# ripetere; per saperlo si leggono gli eventi del tasto durante il tentativo.
PWR=""
for e in /sys/class/input/event*; do
    [ "$(cat "$e/device/name" 2> /dev/null)" = axp2202-pek ] && PWR=/dev/input/${e##*/}
done
PRESSED=/run/arcade-suspend-press
while [ $tries -lt 5 ] && [ "$r" != riuscita ]; do
    tries=$((tries + 1))
    cnt=$(cat /sys/power/wakeup_count 2> /dev/null) || break
    if ! echo "$cnt" > /sys/power/wakeup_count 2> /dev/null; then sleep 1; continue; fi
    echo "arcade: sospensione, tentativo $tries" > /dev/kmsg
    watch=""
    : > "$PRESSED"
    if [ -n "$PWR" ]; then cat "$PWR" > "$PRESSED" 2> /dev/null & watch=$!; fi
    if echo mem > /sys/power/state 2> /dev/null; then
        r=riuscita
    else
        { echo "=== $(date) tentativo $tries"; dmesg | sed -n "/arcade: sospensione, tentativo $tries/,\$p" | tail -80; } >> "$LOGDIR/sospensione.txt"
        sleep 0.2   # gli eventi del tasto arrivano appena i processi ripartono
        if [ -s "$PRESSED" ]; then
            r="annullata dal tasto"
            [ -n "$watch" ] && kill "$watch" 2> /dev/null
            break
        fi
        sleep 1
    fi
    [ -n "$watch" ] && kill "$watch" 2> /dev/null
done
rm -f "$PRESSED"

for k in /sys/class/rfkill/rfkill*; do
    [ "$(cat "$k/type" 2> /dev/null)" = wlan ] && echo 1 > "$k/state" 2> /dev/null
done
rm -f /tmp/system_suspend
touch /tmp/wakeup_from_suspend
echo 1 > /sys/class/led_anim/enable 2> /dev/null
# audio: interruttori e uscita del codec come all'avvio (system-init)
if [ "$(cat "$ROOT/System/audio.conf" 2> /dev/null)" = knulli ]; then
    amixer -q cset name="LINEOUT Output Select" DAC_SINGLE
    amixer -q cset name="LINEOUT volume" 26
fi
# si riapre solo quando il codec si è assestato, altrimenti si sente il crack
sleep 0.4
for c in "Headphone Switch" "HpSpeaker Switch" "LINEOUT Switch"; do amixer -q cset name="$c" on 2> /dev/null; done
[ -w /sys/class/speaker/mute ] && echo 0 > /sys/class/speaker/mute
step "risveglio (sospensione $r, tentativi $tries)"
[ $wifi = 1 ] && ( wifi-ctl on > /dev/null 2>&1 & )
[ "$r" != "non riuscita" ]
