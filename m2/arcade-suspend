#!/bin/sh
# Sospensione della console, come keymon e /sbin/suspendtomem.sh del firmware TrimUI:
# si fermano Wi-Fi e LED, si avvisa trimui_inputd (/tmp/system_suspend: gestisce la
# retroilluminazione), si scrive tutto sulla SD e si sospende in RAM. Il tasto di accensione
# risveglia la console: lo script riprende da "echo mem" e rimette le cose com'erano.
# Lo chiama il launcher o il runner (plat_suspend), che restano fermi finché non torna.
ROOT=${ROOT:-/mnt/SDCARD/Arcade}
LOGDIR=${ARCADE_LOG_DIR:-$ROOT/Logs}
STEPS=$LOGDIR/passi.txt
step() { echo "$(cut -d' ' -f1 /proc/uptime)s sospensione: $1" >> "$STEPS"; }

mute() {
    [ -w /sys/class/speaker/mute ] && echo 1 > /sys/class/speaker/mute
    for c in "Headphone Switch" "HpSpeaker Switch" "LINEOUT Switch"; do amixer -q cset name="$c" off 2> /dev/null; done
}
unmute() {
    for c in "Headphone Switch" "HpSpeaker Switch"; do amixer -q cset name="$c" on 2> /dev/null; done
    # LINEOUT resta spenta: non serve all'altoparlante né alle cuffie e con Wi-Fi e SD in attività
    # faceva rumore (provato su Brick Pro e Smart Pro). System/lineout-on la riaccende.
    [ -f "$ROOT/System/lineout-on" ] && amixer -q cset name="LINEOUT Switch" on 2> /dev/null
    [ -w /sys/class/speaker/mute ] && echo 0 > /sys/class/speaker/mute
}
# "arcade-suspend unmute": launcher e runner riaprono l'uscita audio dopo il risveglio e solo
# allora riattivano l'amplificatore (con ARCADE_KEEP_MUTE=1 lo script lascia l'audio muto)
if [ "$1" = unmute ]; then unmute; exit 0; fi
# "arcade-suspend mute": il launcher spegne l'altoparlante mentre scarica e installa un aggiornamento
if [ "$1" = mute ]; then mute; exit 0; fi

wifi=0
pidof wpa_supplicant > /dev/null && wifi=1
# batteria nei passi: con quella del risveglio si misura quanto consuma lo standby
battery() { cat /sys/class/power_supply/axp2202-battery/capacity 2> /dev/null || echo "?"; }
step "inizio (wi-fi $([ $wifi = 1 ] && echo acceso || echo spento), batteria $(battery)%)"
# Wi-Fi: una ricerca di reti in corso fa rifiutare la sospensione al driver ("phy0 failed to
# suspend: error -16"): si interrompe, si spegne e si blocca la radio (rfkill) come keymon
if [ $wifi = 1 ]; then
    wpa_cli -p /run/wpa -i wlan0 abort_scan > /dev/null 2>&1
    wifi-ctl off > /dev/null 2>&1
fi
for k in /sys/class/rfkill/rfkill*; do
    [ "$(cat "$k/type" 2> /dev/null)" = wlan ] && echo 0 > "$k/state" 2> /dev/null
done
# Il driver acceso da poco rifiuta la sospensione (phy0, errore -16): come fa Knulli, si toglie
# e al risveglio lo ricarica wifi-ctl. Se non si lascia togliere, restano i tentativi qui sotto.
if grep -q '^xradio_wlan ' /proc/modules; then
    if timeout -s KILL 5 rmmod xradio_wlan 2> /dev/null; then step "driver Wi-Fi tolto"
    else step "driver Wi-Fi non tolto"; fi
fi
# LED spenti: le animazioni le calcola il driver led_anim sul processore, e in sospensione si
# fermano (provato su Brick Pro con un respiro lento: si spegne appena la console dorme)
echo 0 > /sys/class/led_anim/enable 2> /dev/null
# audio muto prima di dormire: al risveglio il codec si riavvia e l'amplificatore farebbe un "crack"
mute
# registro dei consumi (Registro diagnostico "Prestazioni"): una misura subito prima di dormire
consumi_mark() { [ -f /run/consumi.pid ] && kill -USR1 "$(cat /run/consumi.pid)" 2> /dev/null && sleep 0.3; }
consumi_mark
touch /tmp/system_suspend
sync

# Per circa 12 secondi dopo l'accensione del Wi-Fi il driver rifiuta la sospensione (phy0, errore
# -16: "need keep awake"), anche a Wi-Fi spento: in quel caso si continua a riprovare più a lungo.
# Il rilascio del tasto è esso stesso un evento di risveglio: si lascia passare mezzo secondo.
# wakeup_count: se arriva un evento di risveglio mentre ci si prepara, la scrittura fallisce
# e si riprova. Se il kernel annulla la sospensione (un dispositivo rifiuta, o un evento di
# risveglio arriva a metà) si riprova fino a 5 volte; i messaggi del kernel di ogni tentativo
# fallito vanno in Logs/sospensione.txt.
sleep 0.5
r="non riuscita"
tries=0
# Spegnere i dispositivi richiede 2-3 secondi e lo schermo si spegne subito: se in quel tempo si
# preme il tasto di accensione, il kernel annulla la sospensione. È un risveglio voluto, da non
# ripetere; per saperlo si leggono gli eventi del tasto durante il tentativo.
PWR=""
for e in /sys/class/input/event*; do
    [ "$(cat "$e/device/name" 2> /dev/null)" = axp2202-pek ] && PWR=/dev/input/${e##*/}
done
PRESSED=/run/arcade-suspend-press
# Sorgenti di risveglio. Il driver della batteria segnala un aggiornamento ogni 10 s
# (power_supply_changed tiene sveglio il dispositivo "axp2202-battery"): se capita mentre ci si
# prepara a dormire, il kernel annulla la sospensione (Brick Pro, 13 novembre: 17 su 28 al secondo
# tentativo, "last active wakeup source: axp2202-battery"). Come fa muOS sulle TrimUI (commit
# 4600add0, settembre 2026), batteria, Wi-Fi e Bluetooth smettono di essere sorgenti di risveglio
# finché si dorme e si rimettono al risveglio; il tasto e gli avvisi del chip di alimentazione
# passano dalla sua interruzione e restano. "batteria-on" in System/prova-sospensione.txt lascia
# tutto com'era. Nei passi: contatori prima e dopo e l'interruzione che ha svegliato la console.
ws_dirs() {
    for d in /sys/class/power_supply/axp2202-battery /sys/class/power_supply/axp2202-usb; do
        for p in "$d/power" "$d/device/power"; do [ -f "$p/wakeup" ] && echo "$p"; done
    done
}
ws_line() {
    for p in $(ws_dirs); do
        n=${p#/sys/class/power_supply/}
        printf ' %s=%s/%s' "${n%%/power}" "$(cat "$p/wakeup" 2> /dev/null)" "$(cat "$p/wakeup_count" 2> /dev/null)"
    done
}
WS_BEFORE=$(ws_line)
QUIET=""
if ! grep -q batteria-on "$ROOT/System/prova-sospensione.txt" 2> /dev/null; then
    for p in /sys/class/power_supply/*battery*/power $(find /sys/devices/platform -maxdepth 4 \( -path "*btlpm*/power" -o -path "*wlan*/power" \) 2> /dev/null); do
        [ "$(cat "$p/wakeup" 2> /dev/null)" = enabled ] && echo disabled > "$p/wakeup" 2> /dev/null && QUIET="$QUIET $p"
    done
fi
max=5
while [ $tries -lt $max ] && [ "$r" != riuscita ]; do
    tries=$((tries + 1))
    cnt=$(cat /sys/power/wakeup_count 2> /dev/null) || break
    if ! echo "$cnt" > /sys/power/wakeup_count 2> /dev/null; then sleep 1; continue; fi
    echo "arcade: sospensione, tentativo $tries" > /dev/kmsg
    watch=""
    : > "$PRESSED"
    if [ -n "$PWR" ]; then cat "$PWR" > "$PRESSED" 2> /dev/null & watch=$!; fi
    if echo mem > /sys/power/state 2> /dev/null; then
        r=riuscita
        # chi l'ha svegliata: il tasto (i suoi eventi arrivano appena i processi ripartono) o altro
        sleep 0.2
        if [ -s "$PRESSED" ]; then woke=tasto; else woke="altro (non il tasto)"; fi
    else
        busy=0; bat=0
        dmesg | tail -14 | grep -q 'phy0 failed to suspend' && { busy=1; max=15; }
        dmesg | tail -14 | grep -q 'wakeup source: axp2202-battery' && bat=1
        # del rifiuto del Wi-Fi basta il primo tentativo: è previsto e il file crescerebbe; per la
        # batteria una riga sola, con i contatori
        if [ $bat = 1 ]; then
            echo "=== $(date) tentativo $tries annullato dalla batteria;$(ws_line)" >> "$LOGDIR/sospensione.txt"
        elif [ $busy = 0 ] || [ $tries = 1 ]; then
            { echo "=== $(date) tentativo $tries"; dmesg | tail -40; } >> "$LOGDIR/sospensione.txt"
        fi
        sleep 0.2   # gli eventi del tasto arrivano appena i processi ripartono
        if [ -s "$PRESSED" ]; then
            r="annullata dal tasto"
            [ -n "$watch" ] && kill "$watch" 2> /dev/null
            break
        fi
        # annullata dalla batteria: si riprova subito, il secondo tentativo di solito passa
        [ $bat = 1 ] || sleep 1
    fi
    [ -n "$watch" ] && kill "$watch" 2> /dev/null
done
rm -f "$PRESSED"
for p in $QUIET; do echo enabled > "$p/wakeup" 2> /dev/null; done
# chi ha svegliato la console: l'interruzione registrata dal kernel e il suo nome
wirq=$(cat /sys/power/pm_wakeup_irq 2> /dev/null)
[ -n "$wirq" ] && wirq="$wirq $(awk -v i="$wirq:" '$1 == i { print $NF; exit }' /proc/interrupts 2> /dev/null)"

for k in /sys/class/rfkill/rfkill*; do
    [ "$(cat "$k/type" 2> /dev/null)" = wlan ] && echo 1 > "$k/state" 2> /dev/null
done
rm -f /tmp/system_suspend
touch /tmp/wakeup_from_suspend
echo 1 > /sys/class/led_anim/enable 2> /dev/null
# audio: interruttori e uscita del codec come all'avvio (system-init)
if [ "$(cat "$ROOT/System/audio.conf" 2> /dev/null)" = knulli ]; then
    amixer -q cset name="LINEOUT Output Select" DAC_SINGLE
    amixer -q cset name="LINEOUT volume" 26
fi
# si riapre solo quando il codec si è assestato, altrimenti si sente il crack
if [ -z "$ARCADE_KEEP_MUTE" ]; then sleep 0.4; unmute; fi
# La SD risponde ancora? Una volta (Smart Pro, dopo la sospensione automatica) dopo il risveglio
# niente si scriveva più sulla scheda e nessun gioco partiva. Scrittura, sync e rilettura in
# sottofondo, al massimo 5 s: con la scheda bloccata sync non tornerebbe più. Se non risponde,
# lo si scrive nei messaggi del kernel e in /run (in memoria) e il launcher propone di riavviare.
rm -f /run/sd-ok
( echo ok > "$ROOT/System/.prova-sd" && sync && [ "$(cat "$ROOT/System/.prova-sd")" = ok ] \
    && rm -f "$ROOT/System/.prova-sd" && : > /run/sd-ok ) 2> /dev/null &
i=0
while [ $i -lt 25 ] && [ ! -f /run/sd-ok ]; do sleep 0.2; i=$((i + 1)); done
if [ ! -f /run/sd-ok ]; then
    echo "arcade: la SD non risponde dopo il risveglio (sospensione $r, tentativi $tries)" > /dev/kmsg
    { echo "risveglio senza SD: $(date)"; dmesg | tail -60; } > /run/sd-guasta 2>&1
    [ $wifi = 1 ] && ( wifi-ctl on > /dev/null 2>&1 & )
    exit 0
fi
step "risveglio (sospensione $r, tentativi $tries, sveglia: ${woke:--}, batteria $(battery)%)"
step "sorgenti di risveglio prima:${WS_BEFORE:- nessuna} dopo:$(ws_line); escluse:${QUIET:- nessuna}; interruzione: ${wirq:-?}"
consumi_mark   # e una al risveglio: batteria prima e dopo dicono quanto consuma lo standby
sync   # la riga del risveglio sulla SD anche se poi la console viene spenta a forza
[ $wifi = 1 ] && ( wifi-ctl on > /dev/null 2>&1 & )
[ "$r" != "non riuscita" ]
